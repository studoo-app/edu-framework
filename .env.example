#
# Fichier de configuration des variables d'environnement du projet
#

## << Config Database
## pour activer la connexion à la base de données, il faut mettre DB_HOST_STATUS=true
DB_HOST_STATUS=true
## Type de base de données (mysql,mariadb,sqlite)
DB_TYPE=mysql
## IP ou nom du serveur de base de données
DB_HOST=127.0.0.1
## Port de la base de données
## (utilisé aussi comme port publié sur l'hôte par compose.yaml)
DB_SOCKET=3306
## Nom de l'utilisateur de la base de données
DB_USER=root
## Mot de passe de l'utilisateur de la base de données
DB_PASSWORD=studoo
## Nom de la base de données
DB_NAME=app_db
## >> Config Database

## << Config préfixe des conteneurs Docker
APP_NAME=edu-framework
## >> Config préfixe des conteneurs Docker

## << Config application
## pour activer le mode dev, il faut mettre APP_ENV=dev
APP_ENV=prod
## >> Config application

## << Config Mailer
MAILER_DSN="smtp://localhost:1025"
## >> Config Mailer

## << Config Docker (ports exposés sur l'hôte, voir compose.yaml)
## À adapter si un autre projet occupe déjà ces ports sur la machine
## Port HTTP du serveur web (FrankenPHP)
HTTP_PORT=80
## Port HTTPS du serveur web (FrankenPHP)
HTTPS_PORT=443
## Port de l'interface phpMyAdmin
PMA_PORT=8081
## Port de l'interface dbgate
DBGATE_PORT=8082
## Port SMTP de Mailpit (à garder aligné avec MAILER_DSN)
MAILER_SMTP_PORT=1025
## Port de l'interface web de Mailpit
MAILER_UI_PORT=8025
## >> Config Docker