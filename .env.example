#
# Fichier de configuration des variables d'environnement du projet
#

## << Config Database
## pour activer la connexion à la base de données, il faut mettre DB_HOST_STATUS=true
DB_HOST_STATUS=true
## Type de base de données (mysql,mariadb,sqlite)
DB_TYPE=mysql
## IP ou nom du serveur de base de données
DB_HOST=127.0.0.1
## Port de la base de données
## (utilisé aussi comme port publié sur l'hôte par compose.yaml)
DB_SOCKET=3306
## Nom de l'utilisateur de la base de données
DB_USER=root
## Mot de passe de l'utilisateur de la base de données
DB_PASSWORD=studoo
## Nom de la base de données
DB_NAME=app_db
## >> Config Database

## << Config préfixe des conteneurs Docker
APP_NAME=edu-framework
## >> Config préfixe des conteneurs Docker

## << Config application
## pour activer le mode dev, il faut mettre APP_ENV=dev
APP_ENV=prod
## >> Config application

## << Config profiler de code (barre de debug, mode dev uniquement)
## Nécessite l'extension PHP Excimer (installée dans l'image Docker)
##   off     -> profiler désactivé
##   trigger -> profilage à la demande : bouton "Code" de la barre de debug
##              (cookie edu_profile=1) ou paramètre ?_profile=1 dans l'URL
##   on      -> chaque requête est profilée
EDU_PROFILER=trigger
## Nombre de profils conservés dans la base des logs
EDU_PROFILER_KEEP=50
## Image Docker : 1 => avec Excimer (défaut), 0 => sans profiler
EDU_PROFILER_BUILD=1
## >> Config profiler de code

## << Config Mailer
MAILER_DSN="smtp://localhost:1025"
## >> Config Mailer

## << Config Docker (ports exposés sur l'hôte, voir compose.yaml)
## À adapter si un autre projet occupe déjà ces ports sur la machine
## Port HTTP du serveur web (FrankenPHP)
HTTP_PORT=80
## Port HTTPS du serveur web (FrankenPHP)
HTTPS_PORT=443
## Nom du serveur FrankenPHP (Caddy), voir la doc "L'application dans Docker" :
##   :80         -> HTTP simple (défaut, pratique en développement)
##   localhost   -> HTTPS local avec certificat auto-signé (tester avec https://localhost)
##   mon-site.fr -> HTTPS via Let's Encrypt (production, domaine public requis)
SERVER_NAME=:80
## Port de l'interface phpMyAdmin
PMA_PORT=8081
## Port de l'interface dbgate
DBGATE_PORT=8082
## Port SMTP de Mailpit (à garder aligné avec MAILER_DSN)
MAILER_SMTP_PORT=1025
## Port de l'interface web de Mailpit
MAILER_UI_PORT=8025
## >> Config Docker