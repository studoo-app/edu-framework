    <script>
        (function() {
            var CONTEXT_MAX = 80;
            var view = 'search';
            var token = '';
            var requestToken = '';
            var sqlToken = '';
            var explainToken = '';
            var explainId = '';
            var explainMode = 'explain';
            var explainOverrides = {};
            var explainRequest = 0;
            var codeToken = '';
            var codeData = null;
            var codeSort = 'self';
            var codeSelected = null;
            var codeMode = 'table';
            var codeCompare = '';
            var codeLoaded = '';
            var codeLog = null;
            var flameCache = {};
            var flame = { data: null, zoom: null, nodes: [], maxDelta: 0, compareFor: '', compareOptions: null };
            var FLAME_ROW = 18;
            var logsStatus = '';
            var searchFilters = { limit: 20 };

            function $(id) { return document.getElementById(id); }
            function el(tag, className, text) {
                var node = document.createElement(tag);
                if (className) { node.className = className; }
                if (text !== undefined && text !== null) { node.textContent = text; }
                return node;
            }

            function statusClass(code) { return 's-' + String(code).charAt(0) + 'xx'; }
            function methodBadge(method) {
                var known = ['GET', 'POST', 'PUT', 'DELETE', 'PATCH'];
                return el('span', 'm-' + (known.indexOf(method) === -1 ? 'OTHER' : method), method);
            }
            function sapiBadge(sapi) {
                if (sapi === undefined || sapi === null || sapi === '') { return document.createTextNode('\u2014'); }
                var known = ['cli-server', 'frankenphp'];
                return el('span', 'sapi-badge' + (known.indexOf(sapi) === -1 ? '' : ' ' + sapi), sapi);
            }
            function prettyNumber(value, decimals) {
                return Number(value).toFixed(decimals).replace('.', ',');
            }
            function prettyDuration(executionTimeMs) {
                return (executionTimeMs === undefined || executionTimeMs === null)
                    ? '\u2014' : prettyNumber(executionTimeMs, 1) + ' ms';
            }
            function prettyMemory(memoryMb) {
                return (memoryMb === undefined || memoryMb === null)
                    ? '\u2014' : prettyNumber(memoryMb, 2) + ' Mo';
            }
            function isHttp(log) { return log.event && log.event.method !== undefined && log.event.method !== null; }
            function requestLink(id, label) {
                var link = el('a', null, label);
                link.href = '#request/' + id;
                return link;
            }
            function timeOf(log) {
                var match = /\d{2}:\d{2}:\d{2}/.exec((log.event && log.event.timestamp) || log.event_date || '');
                return match ? match[0] : '';
            }

            function query(params) {
                var url = new URLSearchParams();
                Object.keys(params).forEach(function(key) {
                    if (params[key] !== '' && params[key] !== undefined && params[key] !== null) { url.set(key, params[key]); }
                });
                return fetch('/edu-logs?' + url.toString()).then(function(response) { return response.json(); });
            }

            function sqlQuery(params) {
                var url = new URLSearchParams();
                Object.keys(params).forEach(function(key) {
                    if (params[key] !== '' && params[key] !== undefined && params[key] !== null) { url.set(key, params[key]); }
                });
                return fetch('/edu-sql-logs?' + url.toString()).then(function(response) { return response.json(); });
            }

            function explainQuery(params) {
                var url = new URLSearchParams();
                Object.keys(params).forEach(function(key) {
                    if (params[key] !== '' && params[key] !== undefined && params[key] !== null) { url.set(key, params[key]); }
                });
                return fetch('/edu-sql-explain?' + url.toString()).then(function(response) { return response.json(); });
            }

            function codeQuery(params) {
                var url = new URLSearchParams();
                Object.keys(params).forEach(function(key) {
                    if (params[key] !== '' && params[key] !== undefined && params[key] !== null) { url.set(key, params[key]); }
                });
                return fetch('/edu-code-profile?' + url.toString()).then(function(response) { return response.json(); });
            }

            function fail(error) { console.error('[EduFramework Profiler]', error); }

            // ----- Contexte d'un log : tronqué si long, complet au clic ("Show full context") -----
            function contextOf(log) {
                var context = {};
                Object.keys(log.event || {}).forEach(function(key) {
                    if (key !== 'path' && key !== 'raw') { context[key] = log.event[key]; }
                });
                return context;
            }

            function buildContext(log) {
                var context = contextOf(log);
                var inline = Object.keys(context).map(function(key) {
                    if (key === 'execution_time_ms') { return key + ' => ' + prettyDuration(context[key]); }
                    if (key === 'memory_mb') { return key + ' => ' + prettyMemory(context[key]); }
                    // Variables GET / POST / session : objets affichés en JSON (et non [object Object])
                    var value = context[key];
                    return key + ' => ' + (value !== null && typeof value === 'object' ? JSON.stringify(value) : value);
                }).join(', ');
                var box = el('div', 'log-context');
                box.appendChild(el('b', null, 'Contexte : '));

                if (inline.length <= CONTEXT_MAX) {
                    box.appendChild(document.createTextNode('[ ' + inline + ' ]'));
                    return box;
                }

                var short = el('span', null, '[ ' + inline.substring(0, CONTEXT_MAX) + ' ... ');
                var link = el('a', null, 'Afficher le contexte complet');
                link.href = '#';
                var full = el('pre', 'hidden', JSON.stringify(log.event, null, 2));
                link.addEventListener('click', function(event) {
                    event.preventDefault();
                    var open = full.classList.toggle('hidden') === false;
                    link.textContent = open ? 'Masquer le contexte' : 'Afficher le contexte complet';
                });
                short.appendChild(link);
                box.appendChild(short);
                box.appendChild(full);
                return box;
            }

            // ----- Vue "messages de log" -----
            function renderSummary(log) {
                var summary = $('summary');
                if (!log || !isHttp(log)) {
                    summary.classList.add('hidden');
                    return;
                }
                summary.classList.remove('hidden');
                summary.className = 'summary ' + statusClass(log.event.status_code);
                $('summaryUrl').textContent = log.event.path;
            }

            // Badges de compteur des onglets par famille de statut,
            // partagés entre les vues Logs et Recherche
            function renderCountBadges(container, counts) {
                container.querySelectorAll('[data-count]').forEach(function(node) {
                    var value = counts[node.getAttribute('data-count')] || 0;
                    node.textContent = value;
                    node.parentNode.classList.toggle('empty', value === 0);
                });
            }

            function renderCounts(counts) {
                renderCountBadges($('tabs'), counts);
                $('sidebarCount').textContent = counts.all || 0;
            }

            function renderLogs(data) {
                var body = $('logsBody');
                body.innerHTML = '';
                renderCounts(data.counts);

                if (data.logs.length === 0) {
                    var tr = el('tr');
                    var td = el('td', 'empty-state', 'Aucun log dans cette cat\u00e9gorie');
                    td.colSpan = 3;
                    tr.appendChild(td);
                    body.appendChild(tr);
                }

                data.logs.forEach(function(log) {
                    var tr = el('tr', isHttp(log) ? 'log-row' : 'raw');
                    tr.appendChild(el('td', 'time', timeOf(log)));

                    if (isHttp(log)) {
                        var tdChannel = el('td', 'channel');
                        tdChannel.appendChild(methodBadge(log.event.method));
                        tdChannel.appendChild(document.createTextNode(' '));
                        tdChannel.appendChild(sapiBadge(log.event.sapi));
                        tr.appendChild(tdChannel);

                        var tdMessage = el('td');
                        tdMessage.appendChild(requestLink(log.id, log.event.path));
                        tdMessage.appendChild(document.createTextNode(' \u2192 '));
                        tdMessage.appendChild(el('span', 'status-text ' + statusClass(log.event.status_code), log.event.status_code));
                        tdMessage.appendChild(buildContext(log));
                        tr.appendChild(tdMessage);
                    } else {
                        tr.appendChild(el('td', 'channel', 'raw'));
                        tr.appendChild(el('td', null, log.event.raw));
                    }
                    body.appendChild(tr);
                });
            }

            function loadLogs() {
                query({ limit: 20, status: logsStatus, token: token }).then(function(data) {
                    renderLogs(data);
                    if (token !== '') {
                        renderSummary(data.logs[0]);
                    } else {
                        return query({ limit: 1 }).then(function(latest) { renderSummary(latest.logs[0]); });
                    }
                }).catch(fail);
            }

            // ----- Vue "recherche" -----
            // Onglets de filtrage par famille de statut, comme la vue des logs :
            // mêmes compteurs serveur (data.counts, indépendants du filtre de statut)
            // et même état actif (famille filtrée via le champ Statut du formulaire)
            function renderSearchTabs(counts) {
                renderCountBadges($('searchTabs'), counts || {});
                var status = searchFilters.status || '';
                document.querySelectorAll('#searchTabs button').forEach(function(node) {
                    node.classList.toggle('active', node.getAttribute('data-status') === status);
                });
            }

            function renderSearch(data) {
                var body = $('searchBody');
                body.innerHTML = '';
                $('searchTotal').textContent = data.total + (data.total > 1 ? ' r\u00e9sultats trouv\u00e9s' : ' r\u00e9sultat trouv\u00e9');
                renderSearchTabs(data.counts);

                if (data.logs.length === 0) {
                    var tr = el('tr');
                    var td = el('td', 'empty-state', 'Aucune requ\u00eate ne correspond \u00e0 cette recherche');
                    td.colSpan = 7;
                    tr.appendChild(td);
                    body.appendChild(tr);
                }

                data.logs.forEach(function(log) {
                    var tr = el('tr');
                    if (!isHttp(log)) {
                        var tdRaw = el('td', null, log.event.raw);
                        tdRaw.colSpan = 6;
                        tr.appendChild(tdRaw);
                    } else {
                        var tdStatus = el('td', 'nowrap');
                        tdStatus.appendChild(el('span', 'status-badge ' + statusClass(log.event.status_code), log.event.status_code));
                        tr.appendChild(tdStatus);
                        tr.appendChild(el('td', null, log.event.ip_port));
                        var tdMethod = el('td');
                        tdMethod.appendChild(methodBadge(log.event.method));
                        tr.appendChild(tdMethod);
                        var tdPath = el('td');
                        tdPath.appendChild(requestLink(log.id, log.event.path));
                        if (log.profiled === true) {
                            var badge = el('a', 'profiled-badge', 'profil');
                            badge.href = '#code/' + log.id;
                            badge.title = 'Profil du code de cette requ\u00eate';
                            tdPath.appendChild(badge);
                        }
                        tr.appendChild(tdPath);
                        var tdSapi = el('td', 'nowrap');
                        tdSapi.appendChild(sapiBadge(log.event.sapi));
                        tr.appendChild(tdSapi);
                        tr.appendChild(el('td', 'time', log.event.timestamp));
                    }
                    var tdToken = el('td');
                    var link = el('a', null, '#' + log.id);
                    link.href = '#logs/' + log.id;
                    tdToken.appendChild(link);
                    tr.appendChild(tdToken);
                    body.appendChild(tr);
                });
            }

            function loadSearch() {
                query(searchFilters).then(renderSearch).catch(fail);
            }

            // ----- Vue "descriptif d'une requête" -----
            function updateRequestNav(id) {
                // L'entrée "Requête" de la navigation ne pointe nulle part tant
                // qu'aucune requête n'a été consultée
                var link = $('navRequest');
                if (id) {
                    link.classList.remove('disabled');
                    link.setAttribute('href', '#request/' + id);
                } else {
                    link.classList.add('disabled');
                    link.setAttribute('href', '#');
                }
            }

            function updateSqlNav(id) {
                // L'entrée "SQL" de la navigation suit la dernière requête SQL consultée
                var link = $('navSql');
                if (id) {
                    link.classList.remove('disabled');
                    link.setAttribute('href', '#sql/' + id);
                } else {
                    link.classList.add('disabled');
                    link.setAttribute('href', '#');
                }
            }

            function updateCodeNav(id) {
                // L'entrée "Code" de la navigation suit le dernier profil consulté
                var link = $('navCode');
                if (id) {
                    link.classList.remove('disabled');
                    link.setAttribute('href', '#code/' + id);
                } else {
                    link.classList.add('disabled');
                    link.setAttribute('href', '#');
                }
            }

            function requestRow(label, valueNode) {
                var tr = el('tr');
                tr.appendChild(el('td', 'req-label', label));
                var td = el('td');
                if (typeof valueNode === 'string') { td.textContent = valueNode; } else { td.appendChild(valueNode); }
                tr.appendChild(td);
                return tr;
            }

            // Tableau clé / valeur des variables GET ou POST d'une requête
            // (les valeurs imbriquées — tableaux — sont affichées en JSON)
            function paramsTable(params) {
                if (params === undefined || params === null || Object.keys(params).length === 0) {
                    return el('span', 'params-empty', 'Aucune variable');
                }
                var table = el('table', 'params-table');
                Object.keys(params).forEach(function (key) {
                    var tr = el('tr');
                    tr.appendChild(el('td', 'param-key', key));
                    var td = el('td', 'param-value');
                    var value = params[key];
                    if (value !== null && typeof value === 'object') {
                        td.appendChild(el('pre', null, JSON.stringify(value, null, 2)));
                    } else {
                        td.textContent = String(value);
                    }
                    tr.appendChild(td);
                    table.appendChild(tr);
                });
                return table;
            }

            function renderRequest(log) {
                var body = $('requestBody');
                body.innerHTML = '';

                if (isHttp(log) === false) {
                    // Log brut (pas une requête HTTP) : on affiche le message seul
                    $('summary').classList.add('hidden');
                    $('requestTitle').textContent = 'Requ\u00eate HTTP';
                    body.appendChild(requestRow('Token', '#' + log.id));
                    body.appendChild(requestRow('Message brut', el('pre', null, log.event.raw || '')));
                    return;
                }

                renderSummary(log);
                $('requestTitle').textContent = 'Requ\u00eate HTTP #' + log.id;
                var e = log.event;

                body.appendChild(requestRow('Token', '#' + log.id));
                body.appendChild(requestRow('M\u00e9thode', methodBadge(e.method)));
                body.appendChild(requestRow('Statut HTTP', el('span', 'status-badge ' + statusClass(e.status_code), e.status_code)));
                body.appendChild(requestRow('URL', (e.path === undefined ? '\u2014' : e.path)));
                body.appendChild(requestRow('Variables GET', paramsTable(e.get)));
                body.appendChild(requestRow('Variables POST', paramsTable(e.post)));
                body.appendChild(requestRow('Session (fin de requ\u00eate)', paramsTable(e.session)));
                body.appendChild(requestRow('IP du client', (e.ip_port === undefined ? '\u2014' : e.ip_port)));
                body.appendChild(requestRow('Serveur (SAPI)', sapiBadge(e.sapi)));
                body.appendChild(requestRow('Dur\u00e9e', prettyDuration(e.execution_time_ms)));
                body.appendChild(requestRow('M\u00e9moire', prettyMemory(e.memory_mb)));
                // Les requêtes SQL de la requête HTTP : le compte est complété
                // par loadRequest() dès que l'API /edu-sql-logs a répondu
                var sqlLink = el('a', null, '\u2014');
                sqlLink.href = '#sql/' + log.id;
                sqlLink.id = 'requestSqlLink';
                body.appendChild(requestRow('Requ\u00eates SQL', sqlLink));
                // Profil du code : présent seulement si la requête a été profilée
                var codeLink = el('a', null, log.profiled === true ? 'Voir le profil du code' : 'Requ\u00eate non profil\u00e9e');
                codeLink.href = '#code/' + log.id;
                codeLink.id = 'requestCodeLink';
                body.appendChild(requestRow('Profil du code', codeLink));
                if (e.error_message !== undefined) {
                    body.appendChild(requestRow('Erreur', el('pre', 'error-message', e.error_message)));
                }
                body.appendChild(requestRow('Re\u00e7ue le', (e.timestamp === undefined ? log.event_date : e.timestamp)));
                body.appendChild(requestRow('Ligne brute', el('pre', null, e.raw || '')));
            }

            function renderRequestEmpty() {
                $('summary').classList.add('hidden');
                $('requestTitle').textContent = 'Requ\u00eate introuvable';
                var body = $('requestBody');
                body.innerHTML = '';
                var tr = el('tr');
                var td = el('td', 'empty-state', 'La requ\u00eate #' + requestToken
                    + ' n\'est plus dans la base des logs (elle a peut-\u00eatre \u00e9t\u00e9 supprim\u00e9e ou la base a \u00e9t\u00e9 r\u00e9initialis\u00e9e)');
                td.colSpan = 2;
                tr.appendChild(td);
                body.appendChild(tr);
            }

            function loadRequest() {
                query({ token: requestToken, limit: 1 }).then(function(data) {
                    if (data.logs.length === 0) {
                        renderRequestEmpty();
                    } else {
                        renderRequest(data.logs[0]);
                        // Complète la ligne "Requêtes SQL" du descriptif avec le compte
                        // et le temps cumulé des requêtes SQL de la requête HTTP
                        sqlQuery({ token: requestToken }).then(function(sql) {
                            var link = $('requestSqlLink');
                            if (link === null) { return; }
                            link.textContent = sql.total === 0
                                ? 'Aucune requ\u00eate SQL'
                                : sql.total + ' requ\u00eate' + (sql.total > 1 ? 's' : '')
                                    + ' \u2014 ' + prettyNumber(sql.total_duration_ms, 1) + ' ms';
                        }).catch(fail);
                    }
                }).catch(fail);
            }

            // ----- Vue "requêtes SQL d'une requête HTTP" -----
            function durationClass(durationMs) {
                if (durationMs > 100) { return 'sql-duration slow'; }
                if (durationMs > 20) { return 'sql-duration medium'; }
                return 'sql-duration';
            }

            function sqlTimeOf(entry) {
                var match = /\d{2}:\d{2}:\d{2}/.exec(entry.event_date || '');
                return match ? match[0] : (entry.event_date || '');
            }

            function renderSql(sqlData, log) {
                var body = $('sqlBody');
                body.innerHTML = '';
                $('sidebarSqlCount').textContent = sqlData.total || 0;
                $('sqlTitle').textContent = sqlData.total + (sqlData.total > 1 ? ' requ\u00eates SQL' : ' requ\u00eate SQL');

                // Totaux : temps SQL cumulé et part du temps de la requête HTTP
                var meta = $('sqlMeta');
                meta.innerHTML = '';
                if (sqlData.total > 0) {
                    meta.appendChild(document.createTextNode('Temps SQL cumul\u00e9 : '));
                    meta.appendChild(el('b', null, prettyNumber(sqlData.total_duration_ms, 1) + ' ms'));
                    var executionTimeMs = (log && log.event && log.event.execution_time_ms !== undefined)
                        ? Number(log.event.execution_time_ms) : 0;
                    if (executionTimeMs > 0) {
                        meta.appendChild(document.createTextNode(
                            ' \u2014 ' + Math.round(sqlData.total_duration_ms / executionTimeMs * 100)
                            + ' % du temps de la requ\u00eate HTTP (' + prettyNumber(executionTimeMs, 1) + ' ms)'
                        ));
                    }
                }

                if (sqlData.queries.length === 0) {
                    var trEmpty = el('tr');
                    var tdEmpty = el('td', 'empty-state', 'Aucune requ\u00eate SQL enregistr\u00e9e pour cette requ\u00eate HTTP');
                    tdEmpty.colSpan = 5;
                    trEmpty.appendChild(tdEmpty);
                    body.appendChild(trEmpty);
                    return;
                }

                // Regroupement des requêtes identiques : badge de nombre d'exécutions
                var groups = {};
                (sqlData.groups || []).forEach(function(group) { groups[group.query] = group; });

                sqlData.queries.forEach(function(entry, index) {
                    var tr = el('tr');
                    tr.appendChild(el('td', 'time', String(index + 1)));

                    var tdQuery = el('td');
                    tdQuery.appendChild(el('pre', 'sql-query', entry.query));
                    var group = groups[entry.query];
                    if (group !== undefined && group.count > 1) {
                        tdQuery.appendChild(el('div', 'sql-group-badge',
                            '\u00d7' + group.count + ' requ\u00eates identiques \u2014 '
                            + prettyNumber(group.duration_ms, 1) + ' ms au total'));
                    }
                    if (/^[\s(]*(select|with|insert|update|delete|replace)\b/i.test(entry.query)) {
                        var actions = el('div', 'sql-actions');
                        var explainLink = el('a', 'btn btn-small btn-explain', 'Analyser le plan (EXPLAIN)');
                        explainLink.href = '#explain/' + sqlToken + '/' + entry.id;
                        actions.appendChild(explainLink);
                        tdQuery.appendChild(actions);
                    }
                    tr.appendChild(tdQuery);

                    tr.appendChild(el('td', durationClass(entry.duration_ms), prettyNumber(entry.duration_ms, 1) + ' ms'));
                    tr.appendChild(el('td', 'time',
                        (entry.rows_count === null || entry.rows_count === undefined) ? '\u2014' : String(entry.rows_count)));
                    tr.appendChild(el('td', 'time', sqlTimeOf(entry)));
                    body.appendChild(tr);
                });
            }

            function loadSql() {
                if (sqlToken === '') {
                    $('summary').classList.add('hidden');
                    renderSql({ token: null, total: 0, total_duration_ms: 0, groups: [], queries: [] }, null);
                    return;
                }

                // Bandeau de la requête (summary) + requêtes SQL : deux appels parallèles
                Promise.all([
                    query({ token: sqlToken, limit: 1 }),
                    sqlQuery({ token: sqlToken })
                ]).then(function(results) {
                    var log = (results[0].logs.length > 0 ? results[0].logs[0] : null);
                    if (log !== null) {
                        renderSummary(log);
                    } else {
                        $('summary').classList.add('hidden');
                    }
                    renderSql(results[1], log);
                }).catch(fail);
            }


            // ----- Vue "analyse EXPLAIN d'une requête SQL" -----
            var EXPLAIN_LEVELS = {
                critical: { label: 'Critique', plural: 'critiques' },
                warning: { label: 'À améliorer', plural: 'à améliorer' },
                info: { label: 'À savoir', plural: 'à savoir' },
                success: { label: 'Bon point', plural: 'bons points' }
            };
            var PLAN_TYPES = {
                system: 'ok', 'const': 'ok', eq_ref: 'ok', ref: 'ok', ref_or_null: 'ok', fulltext: 'ok',
                unique_subquery: 'ok', index_subquery: 'ok', range: 'ok', index_merge: 'mid', index: 'mid', ALL: 'bad'
            };
            var PLAN_COLUMNS = {
                id: 'Numéro du SELECT : les sous-requêtes et UNION ont leur propre numéro',
                select_type: 'SIMPLE, PRIMARY (requête principale), SUBQUERY, DEPENDENT SUBQUERY (corrélée, réexécutée pour chaque ligne), DERIVED (sous-requête du FROM), UNION',
                table: 'Table (ou alias) lue à cette étape. Les lignes sont dans l\'ordre de lecture des tables',
                partitions: 'Partitions lues (tables partitionnées)',
                type: 'Méthode d\'accès, de la meilleure à la pire : system, const, eq_ref, ref, range, index, ALL',
                possible_keys: 'Index que l\'optimiseur pourrait utiliser',
                key: 'Index réellement utilisé (vide : aucun index)',
                key_len: 'Longueur (octets) de la partie de l\'index utilisée',
                ref: 'Colonne ou valeur comparée à l\'index',
                rows: 'Estimation du nombre de lignes lues à cette étape',
                r_rows: 'Nombre réel de lignes lues (ANALYZE)',
                filtered: 'Pourcentage estimé des lignes conservées après le WHERE',
                r_filtered: 'Pourcentage réel des lignes conservées (ANALYZE)',
                r_loops: 'Nombre réel de passages sur la table (ANALYZE)',
                r_total_time_ms: 'Temps réel passé sur la table (ANALYZE)',
                extra: 'Informations complémentaires : Using index, Using where, Using filesort, Using temporary, Using join buffer...',
                detail: 'Étape du plan SQLite : SCAN (parcours complet) ou SEARCH (recherche par index)'
            };

            function formatInt(value) {
                return Number(value).toLocaleString('fr-FR');
            }

            function engineLabel(data) {
                var names = { mysql: 'MySQL', mariadb: 'MariaDB', sqlite: 'SQLite' };
                if (!data.driver) { return ''; }
                var version = (data.server_version || '').replace(/-MariaDB.*$/i, '');
                return (names[data.driver] || data.driver) + (version ? ' ' + version : '');
            }

            function copyButton(targetId, label) {
                var button = el('button', 'btn btn-small', label || 'Copier');
                button.type = 'button';
                button.setAttribute('data-copy', targetId);
                return button;
            }

            function renderExplainMeta(data) {
                var meta = $('explainMeta');
                meta.innerHTML = '';
                var parts = [];
                if (data.duration_ms !== null) { parts.push(['Durée mesurée', prettyNumber(data.duration_ms, 1) + ' ms']); }
                if (data.rows_count !== null) { parts.push(['Lignes', formatInt(data.rows_count)]); }
                if (data.executions > 1) { parts.push(['Exécutions', '×' + data.executions]); }
                if (engineLabel(data) !== '') { parts.push(['Base', engineLabel(data)]); }
                parts.forEach(function(part, index) {
                    if (index > 0) { meta.appendChild(document.createTextNode(' — ')); }
                    meta.appendChild(document.createTextNode(part[0] + ' : '));
                    meta.appendChild(el('b', null, part[1]));
                });
            }

            function renderExplainParams(data) {
                var body = $('explainParamsBody');
                body.innerHTML = '';
                $('explainParams').classList.toggle('hidden', data.params.length === 0);
                var overrides = explainOverrides[explainId] || {};
                data.params.forEach(function(param) {
                    var name = String(param.name);
                    var tr = el('tr');
                    tr.appendChild(el('td', 'param-name', typeof param.name === 'number' ? '? n°' + name : name));
                    var tdInput = el('td');
                    var input = el('input', param.provided ? null : 'missing');
                    input.type = 'text';
                    input.name = name;
                    input.value = (param.value === null || param.value === undefined) ? '' : String(param.value);
                    input.placeholder = param.provided ? 'NULL' : 'valeur à renseigner';
                    input.setAttribute('aria-label', 'Valeur du paramètre ' + name);
                    tdInput.appendChild(input);
                    tr.appendChild(tdInput);
                    tr.appendChild(el('td', 'param-origin', overrides[name] !== undefined
                        ? 'valeur saisie' : (param.provided ? 'valeur enregistrée' : 'valeur inconnue')));
                    body.appendChild(tr);
                });
            }

            function renderExplainModes(data) {
                var analyze = document.querySelector('#explainModes button[data-mode="analyze"]');
                analyze.disabled = (data !== null && data.read_only === false);
                analyze.title = analyze.disabled ? 'EXPLAIN ANALYZE exécute réellement la requête : réservé aux requêtes SELECT' : '';
                document.querySelectorAll('#explainModes button').forEach(function(node) {
                    node.classList.toggle('active', node.getAttribute('data-mode') === explainMode);
                });
                var notes = {
                    explain: 'Le plan est estimé par l\'optimiseur à partir des statistiques des tables : la requête n\'est pas exécutée.',
                    analyze: 'La requête est réellement exécutée (dans une transaction annulée) : le plan indique les temps et les nombres de lignes réels.'
                };
                $('explainModeNote').textContent = notes[explainMode];
            }

            function renderFindings(data) {
                var counts = $('explainCounts');
                var list = $('explainFindings');
                counts.innerHTML = '';
                list.innerHTML = '';
                var total = {};
                data.findings.forEach(function(finding) { total[finding.level] = (total[finding.level] || 0) + 1; });
                Object.keys(EXPLAIN_LEVELS).forEach(function(level) {
                    if (total[level]) {
                        counts.appendChild(el('span', 'level-badge ' + level, total[level] + ' ' + (total[level] > 1 ? EXPLAIN_LEVELS[level].plural : EXPLAIN_LEVELS[level].label.toLowerCase())));
                    }
                });
                if (!total.critical && !total.warning) {
                    var ok = el('div', 'finding success');
                    var head = el('div', 'finding-head');
                    head.appendChild(el('span', 'level-badge success', 'Bon point'));
                    head.appendChild(el('b', null, 'Aucun problème majeur détecté dans le plan'));
                    ok.appendChild(head);
                    ok.appendChild(el('p', null, 'Les tables sont lues efficacement pour le volume actuel. Relancez l\'analyse quand les tables auront grossi : un plan peut changer avec le volume.'));
                    list.appendChild(ok);
                }
                data.findings.forEach(function(finding, index) {
                    var card = el('div', 'finding ' + finding.level);
                    var head = el('div', 'finding-head');
                    head.appendChild(el('span', 'level-badge ' + finding.level, EXPLAIN_LEVELS[finding.level].label));
                    head.appendChild(el('b', null, finding.title));
                    card.appendChild(head);
                    card.appendChild(el('p', null, finding.detail));
                    if (finding.suggestion) {
                        var wrap = el('div', 'sql-suggestion');
                        var pre = el('pre', 'sql-query', finding.suggestion);
                        pre.id = 'explainSuggestion' + index;
                        wrap.appendChild(pre);
                        wrap.appendChild(copyButton(pre.id));
                        card.appendChild(wrap);
                    }
                    list.appendChild(card);
                });

                var script = data.suggestions || [];
                $('explainScript').classList.toggle('hidden', script.length === 0);
                $('explainScriptSql').textContent = script.join('\n');
            }

            function planCell(column, value) {
                var key = column.toLowerCase();
                var td = el('td');
                if (value === null || value === undefined || value === '') {
                    td.className = 'null';
                    td.textContent = 'NULL';
                    return td;
                }
                if (key === 'type') {
                    td.appendChild(el('span', 'plan-type ' + (PLAN_TYPES[value] || ''), value));
                } else if (key === 'extra') {
                    td.className = 'extra';
                    String(value).split(/;\s*/).forEach(function(item) {
                        var level = '';
                        if (/filesort|temporary|join buffer|hash join|BNL|BKA/i.test(item)) { level = 'mid'; }
                        if (/^Using index$|Using index condition|Using index for group-by|Select tables optimized away/i.test(item)) { level = 'ok'; }
                        if (/Impossible WHERE|full scan on NULL key/i.test(item)) { level = 'bad'; }
                        td.appendChild(el('span', 'plan-flag ' + level, item));
                    });
                } else if (key === 'rows' || key === 'r_rows') {
                    td.textContent = formatInt(value);
                } else {
                    td.textContent = String(value);
                }
                return td;
            }

            function renderPlanTable(target, columns, rows) {
                var table = el('table', 'profiler-table plan-table');
                var thead = el('thead');
                var trHead = el('tr');
                columns.forEach(function(column) {
                    var th = el('th');
                    var help = PLAN_COLUMNS[column.toLowerCase()];
                    if (help) {
                        var abbr = el('abbr', null, column);
                        abbr.title = help;
                        th.appendChild(abbr);
                    } else {
                        th.textContent = column;
                    }
                    trHead.appendChild(th);
                });
                thead.appendChild(trHead);
                table.appendChild(thead);
                var tbody = el('tbody');
                rows.forEach(function(row) {
                    var tr = el('tr');
                    columns.forEach(function(column) { tr.appendChild(planCell(column, row[column])); });
                    tbody.appendChild(tr);
                });
                table.appendChild(tbody);
                var wrap = el('div');
                wrap.style.overflowX = 'auto';
                wrap.appendChild(table);
                target.appendChild(wrap);
            }

            function planLineClass(text) {
                if (/<temporary>/i.test(text)) { return 'mid'; }
                if (/^SCAN\b(?!.*USING)|Table scan|full scan|^SCAN TABLE/i.test(text)) { return 'bad'; }
                if (/TEMP B-TREE|AUTOMATIC|Sort|temporary|hash join|Hash$|CORRELATED|DEPENDENT|Materialize/i.test(text)) { return 'mid'; }
                if (/^SEARCH|index lookup|Index range scan|Covering index|Index scan|Single-row|USING (COVERING )?INDEX|PRIMARY KEY/i.test(text)) { return 'ok'; }
                return '';
            }

            function renderSqliteTree(target, rows) {
                var children = {};
                rows.forEach(function(row) {
                    var parent = String(row.parent);
                    (children[parent] = children[parent] || []).push(row);
                });
                function build(parentId) {
                    var ul = el('ul');
                    (children[parentId] || []).forEach(function(row) {
                        var li = el('li');
                        li.appendChild(el('span', 'plan-line ' + planLineClass(String(row.detail)), String(row.detail)));
                        if (children[String(row.id)]) { li.appendChild(build(String(row.id))); }
                        ul.appendChild(li);
                    });
                    return ul;
                }
                var tree = el('div', 'plan-tree');
                tree.appendChild(build('0'));
                target.appendChild(tree);
            }

            function renderMysqlTree(target, text) {
                var pre = el('pre', 'plan-text');
                String(text).split('\n').forEach(function(line, index) {
                    if (index > 0) { pre.appendChild(document.createTextNode('\n')); }
                    var match = /^(.*?)(\(actual time=.*\))?\s*$/.exec(line);
                    pre.appendChild(el('span', 'plan-line ' + planLineClass(line.replace(/^\s*->\s*/, '')), match[1]));
                    if (match[2]) { pre.appendChild(el('span', 'actual', match[2])); }
                });
                target.appendChild(pre);
            }

            function renderPlan(data) {
                var plan = $('explainPlan');
                var analysis = $('explainAnalysis');
                plan.innerHTML = '';
                analysis.innerHTML = '';
                var mariaAnalyze = data.analysis && data.analysis.rows && data.analysis.rows.length > 0;
                $('explainStatement').textContent = mariaAnalyze ? data.analysis.statement : (data.plan.statement || '');

                if (data.driver === 'sqlite') {
                    renderSqliteTree(plan, data.plan.rows);
                } else if (mariaAnalyze) {
                    renderPlanTable(plan, data.analysis.columns, data.analysis.rows);
                    plan.appendChild(el('p', 'code-note', 'Les colonnes r_* sont mesurées pendant l\'exécution : comparez rows (estimé) et r_rows (réel), filtered et r_filtered.'));
                } else {
                    renderPlanTable(plan, data.plan.columns, data.plan.rows);
                }

                if (data.analysis) {
                    analysis.appendChild(el('h3', null, 'Exécution réelle'));
                    var summary = el('p', 'sql-meta');
                    summary.appendChild(document.createTextNode('Temps mesuré pendant l\'analyse : '));
                    summary.appendChild(el('b', null, prettyNumber(data.analysis.time_ms, 1) + ' ms'));
                    if (data.analysis.rows_count !== null) {
                        summary.appendChild(document.createTextNode(' — ' + formatInt(data.analysis.rows_count) + ' ligne(s) retournée(s)'));
                    }
                    analysis.appendChild(summary);
                    if (data.analysis.tree) {
                        renderMysqlTree(analysis, data.analysis.tree);
                        analysis.appendChild(el('p', 'code-note', 'L\'arbre se lit de l\'intérieur vers l\'extérieur : les étapes les plus indentées sont exécutées en premier. actual time=première ligne..dernière ligne (ms), rows=lignes réelles, loops=nombre d\'exécutions de l\'étape.'));
                    }
                }
            }

            function renderTables(data) {
                var target = $('explainTables');
                target.innerHTML = '';
                if (data.tables.length === 0) {
                    target.appendChild(el('p', 'code-note', 'Structure des tables indisponible.'));
                    return;
                }
                data.tables.forEach(function(table) {
                    var wrap = el('div');
                    var t = el('table', 'profiler-table');
                    var thead = el('thead');
                    var trHead = el('tr');
                    var th = el('th');
                    th.colSpan = 2;
                    th.appendChild(document.createTextNode(table.name));
                    if (table.rows !== null) {
                        th.appendChild(el('span', 'code-file', (data.driver === 'sqlite' ? '' : '≈ ') + formatInt(table.rows) + ' lignes'));
                    }
                    trHead.appendChild(th);
                    thead.appendChild(trHead);
                    t.appendChild(thead);
                    var tbody = el('tbody');
                    if (table.indexes.length === 0) {
                        var trEmpty = el('tr');
                        var tdEmpty = el('td', 'empty-state', 'Aucun index');
                        tdEmpty.colSpan = 2;
                        trEmpty.appendChild(tdEmpty);
                        tbody.appendChild(trEmpty);
                    }
                    table.indexes.forEach(function(index) {
                        var tr = el('tr');
                        var tdName = el('td', null, index.name);
                        if (index.primary) { tdName.appendChild(el('span', 'tag pk', 'clé primaire')); }
                        else if (index.unique) { tdName.appendChild(el('span', 'tag', 'unique')); }
                        tr.appendChild(tdName);
                        tr.appendChild(el('td', 'idx-cols', '(' + index.columns.join(', ') + ')'));
                        tbody.appendChild(tr);
                    });
                    t.appendChild(tbody);
                    wrap.appendChild(t);
                    target.appendChild(wrap);
                });
            }

            function renderExplainHelp(driver) {
                var body = $('explainHelpBody');
                if (body.getAttribute('data-driver') === driver) { return; }
                body.setAttribute('data-driver', driver);
                body.innerHTML = '';
                function list(title, items) {
                    body.appendChild(el('h4', null, title));
                    var dl = el('dl');
                    items.forEach(function(item) {
                        var dt = el('dt');
                        dt.appendChild(el('span', item[2] ? 'plan-type ' + item[2] : null, item[0]));
                        dl.appendChild(dt);
                        dl.appendChild(el('dd', null, item[1]));
                    });
                    body.appendChild(dl);
                }
                if (driver === 'sqlite') {
                    list('Étapes du plan SQLite', [
                        ['SCAN t', 'Parcours complet de la table : toutes les lignes sont lues.', 'bad'],
                        ['SCAN t USING INDEX i', 'Parcours complet de l\'index i (dans l\'ordre de l\'index).', 'mid'],
                        ['SEARCH t USING INDEX i (col=?)', 'Recherche par index : seules les lignes correspondantes sont lues.', 'ok'],
                        ['USING COVERING INDEX', 'Index couvrant : la table n\'est pas lue, l\'index suffit.', 'ok'],
                        ['AUTOMATIC INDEX', 'Index temporaire construit à chaque exécution : il manque un index.', 'mid'],
                        ['USE TEMP B-TREE', 'Structure temporaire pour trier (ORDER BY) ou regrouper (GROUP BY, DISTINCT).', 'mid'],
                        ['CORRELATED SUBQUERY', 'Sous-requête réexécutée pour chaque ligne de la requête principale.', 'mid']
                    ]);
                    return;
                }
                list('Colonne type : méthode d\'accès, de la meilleure à la pire', [
                    ['system / const', 'Une seule ligne, trouvée par la clé primaire ou un index unique.', 'ok'],
                    ['eq_ref', 'Jointure : une seule ligne lue pour chaque ligne de la table précédente (clé unique).', 'ok'],
                    ['ref', 'Lignes trouvées par un index non unique (WHERE col = valeur, jointure sur une clé étrangère indexée).', 'ok'],
                    ['range', 'Plage d\'un index : <, >, BETWEEN, IN, LIKE \'abc%\'.', 'ok'],
                    ['index', 'Parcours complet de l\'index : toutes ses entrées sont lues.', 'mid'],
                    ['ALL', 'Parcours complet de la table : toutes les lignes sont lues. À surveiller dès que la table grossit.', 'bad']
                ]);
                list('Colonne Extra', [
                    ['Using index', 'Index couvrant : la requête est satisfaite par l\'index seul.', 'ok'],
                    ['Using where', 'Les lignes lues sont filtrées par le WHERE après lecture.', ''],
                    ['Using filesort', 'Tri supplémentaire du résultat (ORDER BY sans index adapté).', 'mid'],
                    ['Using temporary', 'Table temporaire pour GROUP BY, DISTINCT ou UNION.', 'mid'],
                    ['Using join buffer', 'Jointure sans index : les lignes sont comparées en mémoire (hash join, BNL).', 'mid']
                ]);
            }

            function loadExplain() {
                var request = ++explainRequest;
                $('explainBackLink').setAttribute('href', '#sql/' + explainToken);
                $('explainResult').classList.add('hidden');
                $('explainError').classList.add('hidden');
                $('explainMessage').className = 'explain-message loading';
                $('explainMessage').textContent = explainMode === 'analyze' ? 'Exécution de la requête et analyse en cours…' : 'Analyse en cours…';
                renderExplainModes(null);
                if (explainId === '') {
                    $('explainMessage').className = 'explain-message';
                    $('explainMessage').textContent = 'Choisissez une requête dans la liste des requêtes SQL.';
                    return;
                }

                var params = { id: explainId, analyze: explainMode === 'analyze' ? '1' : '' };
                if (explainOverrides[explainId]) { params.params = JSON.stringify(explainOverrides[explainId]); }

                Promise.all([
                    explainToken !== '' ? query({ token: explainToken, limit: 1 }) : Promise.resolve({ logs: [] }),
                    explainQuery(params)
                ]).then(function(results) {
                    if (request !== explainRequest) { return; }
                    var log = (results[0].logs && results[0].logs.length > 0 ? results[0].logs[0] : null);
                    if (log !== null) { renderSummary(log); } else { $('summary').classList.add('hidden'); }
                    renderExplain(results[1]);
                }).catch(function(error) {
                    $('explainMessage').className = 'explain-message';
                    $('explainMessage').textContent = 'L\'analyse a échoué : consultez la console du navigateur.';
                    fail(error);
                });
            }

            function renderExplain(data) {
                $('explainQuery').textContent = data.query || '';
                renderExplainMeta(data);
                renderExplainParams(data);
                renderExplainModes(data);

                $('explainMessage').className = 'explain-message' + (data.message ? '' : ' hidden');
                $('explainMessage').textContent = data.message || '';
                $('explainError').classList.toggle('hidden', !data.error);
                $('explainError').textContent = data.error || '';

                if (!data.plan) { return; }
                $('explainResult').classList.remove('hidden');
                renderFindings(data);
                renderPlan(data);
                renderTables(data);
                renderExplainHelp(data.driver);
            }

            $('explainModes').addEventListener('click', function(event) {
                var button = event.target.closest('button');
                if (button === null || button.disabled) { return; }
                window.location.hash = '#explain/' + explainToken + '/' + explainId
                    + (button.getAttribute('data-mode') === 'analyze' ? '/analyze' : '');
            });

            $('explainParamsForm').addEventListener('submit', function(event) {
                event.preventDefault();
                var values = {};
                $('explainParamsBody').querySelectorAll('input').forEach(function(input) { values[input.name] = input.value; });
                explainOverrides[explainId] = values;
                loadExplain();
            });

            // Boutons "Copier" : copie le texte de l'élément désigné par data-copy
            document.addEventListener('click', function(event) {
                var button = event.target.closest('button[data-copy]');
                if (button === null) { return; }
                var text = $(button.getAttribute('data-copy')).textContent;
                var done = function() {
                    var label = button.textContent;
                    button.textContent = 'Copié !';
                    setTimeout(function() { button.textContent = label; }, 1500);
                };
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(text).then(done).catch(fail);
                }
            });

            // ----- Vue "profil du code d'une requête HTTP" -----
            function originBadge(origin) {
                var labels = { app: 'mon code', framework: 'framework', vendor: 'vendor', other: 'autre' };
                return el('span', 'origin-badge ' + origin, labels[origin] || origin);
            }

            function codeFilters() {
                var origins = [];
                document.querySelectorAll('#codeFilters input:checked').forEach(function(node) { origins.push(node.value); });
                return origins;
            }

            function timeCell(ms, pct, max) {
                var td = el('td', 'nowrap');
                var bar = el('span', 'code-bar');
                bar.style.width = Math.max(2, Math.round(pct / Math.max(max, 1) * 80)) + 'px';
                td.appendChild(bar);
                td.appendChild(el('b', null, prettyNumber(ms, 2) + ' ms'));
                td.appendChild(document.createTextNode(' (' + prettyNumber(pct, 1) + ' %)'));
                return td;
            }

            function renderCodeEmpty(message) {
                $('codeMeta').innerHTML = '';
                $('codeActions').classList.add('hidden');
                $('codeGraph').classList.add('hidden');
                var body = $('codeBody');
                body.innerHTML = '';
                var tr = el('tr');
                var td = el('td', 'empty-state');
                td.colSpan = 4;
                td.appendChild(document.createTextNode(message + ' '));
                var activate = el('a', null, 'Activer le profilage et rouvrir la page');
                activate.href = '#';
                activate.addEventListener('click', function(event) {
                    event.preventDefault();
                    document.cookie = 'edu_profile=1; path=/; SameSite=Lax';
                    query({ token: codeToken, limit: 1 }).then(function(data) {
                        var path = (data.logs.length > 0 && data.logs[0].event) ? data.logs[0].event.path : '/';
                        // Seule une URL du site est rouverte (le chemin journalisé vient de la requête HTTP)
                        var url = new URL(path || '/', window.location.origin);
                        if (url.origin !== window.location.origin) { url = new URL('/', window.location.origin); }
                        window.open(url.href, '_blank', 'noopener');
                    }).catch(fail);
                });
                td.appendChild(activate);
                tr.appendChild(td);
                body.appendChild(tr);
            }

            function renderCodeTable() {
                var body = $('codeBody');
                body.innerHTML = '';
                var origins = codeFilters();
                var functions = codeData.functions.filter(function(fn) {
                    return origins.indexOf(fn.origin) !== -1 && (fn.self > 0 || fn.inclusive > 0);
                });
                functions.sort(function(a, b) { return b[codeSort] - a[codeSort]; });
                document.querySelectorAll('#codeTable th.sortable').forEach(function(node) {
                    node.classList.toggle('sorted', node.getAttribute('data-sort') === codeSort);
                });

                if (functions.length === 0) {
                    var trEmpty = el('tr');
                    var tdEmpty = el('td', 'empty-state', 'Aucune fonction pour ce filtre : cochez Framework ou Autre pour voir le reste du code ex\u00e9cut\u00e9');
                    tdEmpty.colSpan = 4;
                    trEmpty.appendChild(tdEmpty);
                    body.appendChild(trEmpty);
                    return;
                }

                var maxSelf = Math.max.apply(null, functions.map(function(fn) { return fn.self_pct; }));
                var maxInclusive = Math.max.apply(null, functions.map(function(fn) { return fn.inclusive_pct; }));
                functions.forEach(function(fn) {
                    var tr = el('tr', fn.origin === 'app' ? 'app' : null);
                    if (fn.name === codeSelected) { tr.classList.add('selected'); }
                    var tdName = el('td');
                    // Bouton : la sélection est aussi accessible au clavier
                    var nameButton = el('button', 'code-fn code-fn-btn', fn.name);
                    nameButton.type = 'button';
                    nameButton.addEventListener('click', function(event) { event.stopPropagation(); selectFunction(fn.name); });
                    tdName.appendChild(nameButton);
                    if (fn.file) { tdName.appendChild(el('span', 'code-file', fn.file + (fn.line ? ':' + fn.line : ''))); }
                    tr.appendChild(tdName);
                    var tdOrigin = el('td');
                    tdOrigin.appendChild(originBadge(fn.origin));
                    tr.appendChild(tdOrigin);
                    tr.appendChild(timeCell(fn.self_ms, fn.self_pct, maxSelf));
                    tr.appendChild(timeCell(fn.inclusive_ms, fn.inclusive_pct, maxInclusive));
                    tr.addEventListener('click', function() { selectFunction(fn.name); });
                    body.appendChild(tr);
                });
            }

            function graphRows(target, edges, key) {
                target.innerHTML = '';
                if (edges.length === 0) {
                    var tr = el('tr');
                    tr.appendChild(el('td', 'empty-state', '\u2014'));
                    target.appendChild(tr);
                    return;
                }
                edges.forEach(function(edge) {
                    var tr = el('tr');
                    var td = el('td');
                    var link = el('button', 'code-fn code-fn-btn', edge[key]);
                    link.type = 'button';
                    link.addEventListener('click', function() { selectFunction(edge[key]); });
                    td.appendChild(link);
                    tr.appendChild(td);
                    tr.appendChild(el('td', 'nowrap', prettyNumber(edge.ms, 2) + ' ms'));
                    target.appendChild(tr);
                });
            }

            function selectFunction(name) {
                codeSelected = name;
                renderCodeTable();
                $('codeGraph').classList.remove('hidden');
                $('codeGraphTitle').textContent = name;
                graphRows($('codeCallers'), codeData.edges.filter(function(edge) { return edge.callee === name; }), 'caller');
                graphRows($('codeCallees'), codeData.edges.filter(function(edge) { return edge.caller === name; }), 'callee');
                $('codeGraph').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }

            function renderCode(data) {
                codeSelected = null;
                $('codeGraph').classList.add('hidden');
                $('codeTitle').textContent = 'Profil du code \u2014 requ\u00eate #' + codeToken;
                if (data.status !== 'ready') {
                    codeData = null;
                    showCodeMode();
                    renderCodeEmpty('Cette requ\u00eate n\'a pas \u00e9t\u00e9 profil\u00e9e (ou le profil a \u00e9t\u00e9 supprim\u00e9 : seuls les derniers sont conserv\u00e9s).');
                    return;
                }
                codeData = data;
                var meta = $('codeMeta');
                meta.innerHTML = '';
                meta.appendChild(document.createTextNode('Temps profil\u00e9 : '));
                meta.appendChild(el('b', null, prettyNumber(data.summary.wall_ms, 1) + ' ms'));
                meta.appendChild(document.createTextNode(' \u2014 ' + data.summary.samples + ' \u00e9chantillons (1 toutes les '
                    + prettyNumber(data.summary.period_ms, 1) + ' ms) \u2014 ' + data.summary.functions_count + ' fonctions \u2014 m\u00e9moire '
                    + prettyMemory(data.summary.peak_mb) + ' \u2014 driver ' + data.summary.driver));
                $('codeActions').classList.remove('hidden');
                $('codeSpeedscope').href = '/edu-code-profile?token=' + encodeURIComponent(codeToken) + '&format=speedscope';
                $('codeSpeedscope').setAttribute('download', 'edu-profile-' + codeToken + '.speedscope.json');
                showCodeMode();
                renderCodeTable();
            }

            function loadCode() {
                if (codeToken === '') {
                    $('summary').classList.add('hidden');
                    renderCode({ status: 'pending' });
                    return;
                }
                // Même requête (changement d'onglet Tableau / Flamegraph) : pas de rechargement
                if (codeLoaded === codeToken) {
                    if (codeLog !== null) { renderSummary(codeLog); }
                    showCodeMode();
                    if (codeMode !== 'table' && codeData !== null) { loadFlame(); }
                    return;
                }
                var requested = codeToken;
                Promise.all([
                    query({ token: requested, limit: 1 }),
                    codeQuery({ token: requested, full: 1 })
                ]).then(function(results) {
                    // Réponse d'un profil qui n'est plus affiché : ignorée
                    if (requested !== codeToken || window.location.hash.indexOf('#code/') !== 0) { return; }
                    var log = (results[0].logs.length > 0 ? results[0].logs[0] : null);
                    // Profil pas encore enregistré : il sera redemandé à la prochaine visite
                    codeLoaded = (results[1].status === 'ready' ? requested : '');
                    codeLog = log;
                    if (log !== null) {
                        renderSummary(log);
                    } else {
                        $('summary').classList.add('hidden');
                    }
                    renderCode(results[1]);
                    if (codeMode !== 'table' && codeData !== null) { loadFlame(); }
                }).catch(fail);
            }

            // ----- Flamegraph intégré (onglet Code) -----
            // Modes : heavy (appels regroupés, le plus coûteux à gauche), time (ordre
            // chronologique) et diff (comparaison avec une autre requête profilée)
            function codeHash(mode, compare) {
                var suffix = { table: '', heavy: '/flame', time: '/time', diff: '/diff' }[mode];
                return '#code/' + codeToken + suffix + (mode === 'diff' && compare ? '/' + compare : '');
            }

            function showCodeMode() {
                var ready = codeData !== null;
                var isTable = codeMode === 'table';
                $('codeModes').classList.toggle('hidden', !ready);
                document.querySelectorAll('#codeModes button').forEach(function(node) {
                    node.classList.toggle('active', node.getAttribute('data-mode') === codeMode);
                });
                $('codeTableView').classList.toggle('hidden', ready && !isTable);
                $('codeFlame').classList.toggle('hidden', !ready || isTable);
                $('flameCompare').classList.toggle('hidden', codeMode !== 'diff');
                if (isTable) { hideFlameTooltip(); }
            }

            function flameMessage(message) {
                flame.data = null;
                flame.nodes = [];
                $('flameChart').innerHTML = '';
                $('flameChart').classList.toggle('hidden', message !== null);
                $('flameAxis').classList.add('hidden');
                $('flameCrumbs').innerHTML = '';
                $('flameMeta').innerHTML = '';
                $('flameLegend').innerHTML = '';
                $('flameMatch').textContent = '';
                $('flameDetail').classList.add('hidden');
                $('flameEmpty').classList.toggle('hidden', message === null);
                $('flameEmpty').textContent = message || '';
            }

            function loadFlame() {
                if (codeMode === 'diff') {
                    loadCompareOptions().then(function(options) {
                        if (codeMode !== 'diff') { return; }
                        fillCompareSelect(options);
                        if (codeCompare === '') {
                            if (options.length === 0) {
                                flameMessage('Aucune autre requête profilée à comparer : profilez une seconde fois cette page (ou une autre), puis revenez sur cet onglet.');
                                return;
                            }
                            // Par défaut : la requête profilée précédente sur la même URL
                            window.location.replace(codeHash('diff', options[0].id));
                            return;
                        }
                        fetchFlame();
                    }).catch(fail);
                    return;
                }
                fetchFlame();
            }

            function fetchFlame() {
                var key = codeToken + '/' + codeMode + '/' + codeCompare;
                if (flameCache[key] !== undefined) { setFlame(flameCache[key]); return; }
                flameMessage('Chargement du flamegraph…');
                var params = { token: codeToken, format: 'flame' };
                if (codeMode === 'time') { params.order = 'time'; }
                if (codeMode === 'diff') { params.compare = codeCompare; }
                codeQuery(params).then(function(data) {
                    flameCache[key] = data;
                    // Réponse d'un mode qui n'est plus affiché : gardée en cache seulement
                    if (key !== codeToken + '/' + codeMode + '/' + codeCompare) { return; }
                    setFlame(data);
                }).catch(fail);
            }

            // Requêtes profilées proposées pour la comparaison : la même URL d'abord
            function loadCompareOptions() {
                if (flame.compareFor === codeToken && flame.compareOptions !== null) {
                    return Promise.resolve(flame.compareOptions);
                }
                var path = (codeLog && codeLog.event) ? (codeLog.event.path || '') : '';
                var requested = codeToken;
                return Promise.all([
                    path !== '' ? query({ url: path, limit: 100 }) : Promise.resolve({ logs: [] }),
                    query({ limit: 100 })
                ]).then(function(results) {
                    var seen = {};
                    var same = [];
                    var others = [];
                    results[0].logs.concat(results[1].logs).forEach(function(log) {
                        if (log.profiled !== true || String(log.id) === requested || seen[log.id]) { return; }
                        seen[log.id] = true;
                        var option = { id: String(log.id), log: log, same: isHttp(log) && log.event.path === path };
                        (option.same ? same : others).push(option);
                    });
                    // Même URL : la requête précédente d'abord, puis les suivantes
                    same.sort(function(a, b) {
                        var aBefore = Number(a.id) < Number(requested);
                        var bBefore = Number(b.id) < Number(requested);
                        return (aBefore === bBefore) ? Number(b.id) - Number(a.id) : (aBefore ? -1 : 1);
                    });
                    flame.compareFor = requested;
                    flame.compareOptions = same.concat(others);
                    return flame.compareOptions;
                });
            }

            function fillCompareSelect(options) {
                var select = $('flameCompareSelect');
                select.innerHTML = '';
                var groups = [['Même URL', true], ['Autres requêtes profilées', false]];
                groups.forEach(function(group) {
                    var list = options.filter(function(option) { return option.same === group[1]; });
                    if (list.length === 0) { return; }
                    var optgroup = el('optgroup');
                    optgroup.label = group[0];
                    list.forEach(function(option) {
                        var log = option.log;
                        var label = '#' + option.id + ' — ' + (isHttp(log) ? log.event.method + ' ' + (log.event.path || '') : '')
                            + ' — ' + timeOf(log) + ' — ' + prettyDuration(log.event.execution_time_ms);
                        var node = el('option', null, label);
                        node.value = option.id;
                        optgroup.appendChild(node);
                    });
                    select.appendChild(optgroup);
                });
                select.value = codeCompare;
            }

            // Prépare l'arbre : parent et profondeur de chaque nœud, plus grand écart du diff
            function annotateFlame(node, parent, depth) {
                node._parent = parent;
                node._depth = depth;
                if (parent !== null && typeof node.delta_ms === 'number') {
                    flame.maxDelta = Math.max(flame.maxDelta, Math.abs(node.delta_ms));
                }
                node.children.forEach(function(child) { annotateFlame(child, node, depth + 1); });
            }

            function setFlame(data) {
                if (data.status !== 'ready' || !data.tree) {
                    flameMessage(codeMode === 'diff'
                        ? 'La requête #' + codeCompare + ' n\'a pas de profil de code (ou il a été supprimé).'
                        : 'Le profil de cette requête n\'est pas disponible.');
                    return;
                }
                if (data.tree.value === 0) {
                    flameMessage('Aucune pile d\'appels enregistrée pour cette requête (requête trop courte pour la période d\'échantillonnage).');
                    return;
                }
                flameMessage(null);
                flame.data = data;
                flame.maxDelta = 0;
                annotateFlame(data.tree, null, 0);
                flame.maxDelta = Math.max(flame.maxDelta, 0.01);
                flame.zoom = data.tree;
                renderFlameMeta();
                renderFlameLegend();
                renderFlame();
            }

            function renderFlameMeta() {
                var meta = $('flameMeta');
                var data = flame.data;
                meta.innerHTML = '';
                if (codeMode === 'diff') {
                    var delta = data.summary.wall_ms - data.compare_summary.wall_ms;
                    meta.appendChild(document.createTextNode('Requête #' + data.token + ' : '));
                    meta.appendChild(el('b', null, prettyNumber(data.summary.wall_ms, 1) + ' ms'));
                    meta.appendChild(document.createTextNode(' — référence #' + data.compare + ' : '));
                    meta.appendChild(el('b', null, prettyNumber(data.compare_summary.wall_ms, 1) + ' ms'));
                    meta.appendChild(document.createTextNode(' — écart : ' + (delta > 0 ? '+' : '') + prettyNumber(delta, 1)
                        + ' ms. La forme est celle de la requête #' + data.token + ', la couleur indique l\'écart avec la référence.'));
                    return;
                }
                meta.appendChild(document.createTextNode(codeMode === 'time'
                    ? 'Ordre chronologique : l\'axe horizontal est le temps écoulé depuis le début de la requête.'
                    : 'Appels regroupés : les appels identiques sont additionnés, le plus coûteux à gauche.'));
            }

            function renderFlameLegend() {
                var legend = $('flameLegend');
                legend.innerHTML = '';
                var items = (codeMode === 'diff')
                    ? [['hsl(0, 75%, 62%)', 'plus lent que la référence'], ['hsl(210, 75%, 62%)', 'plus rapide'], ['#e4e4e4', 'identique ou non comparable']]
                    : [[flameColor({ origin: 'app', name: '' }), 'mon code (app/)'], [flameColor({ origin: 'framework', name: '' }), 'framework'],
                        [flameColor({ origin: 'vendor', name: '' }), 'dépendances (vendor/)'], [flameColor({ origin: 'other', name: '' }), 'autre']];
                items.forEach(function(item) {
                    var span = el('span');
                    var swatch = el('i');
                    swatch.style.background = item[0];
                    span.appendChild(swatch);
                    span.appendChild(document.createTextNode(item[1]));
                    legend.appendChild(span);
                });
            }

            // Couleur d'un rectangle : selon l'origine du code (teinte) et le nom de la
            // fonction (nuance), ou selon l'écart avec la référence pour un diff
            function flameColor(node) {
                if (codeMode === 'diff') {
                    if (typeof node.delta_ms !== 'number') { return '#e4e4e4'; }
                    var ratio = Math.min(1, Math.abs(node.delta_ms) / flame.maxDelta);
                    if (ratio < 0.05) { return '#e4e4e4'; }
                    return 'hsl(' + (node.delta_ms > 0 ? 0 : 210) + ', 75%, ' + Math.round(92 - ratio * 30) + '%)';
                }
                var hash = 0;
                for (var i = 0; i < node.name.length; i++) { hash = (hash * 31 + node.name.charCodeAt(i)) | 0; }
                var light = 72 + Math.abs(hash) % 12;
                var colors = { app: [45, 90], framework: [212, 65], vendor: [268, 45] };
                var color = colors[node.origin];
                return color ? 'hsl(' + color[0] + ', ' + color[1] + '%, ' + light + '%)' : 'hsl(0, 0%, ' + light + '%)';
            }

            function flameMs(ms) { return prettyNumber(ms, 2) + ' ms'; }

            function renderFlame() {
                var chart = $('flameChart');
                var zoom = flame.zoom;
                var width = chart.clientWidth || 800;
                var scale = width / Math.max(zoom.value, 1);
                var depthMax = zoom._depth;
                chart.innerHTML = '';
                flame.nodes = [];

                function draw(node, x, w, ancestor) {
                    var button = el('button', 'flame-node' + (ancestor ? ' ancestor' : ''));
                    button.type = 'button';
                    button.style.left = x + 'px';
                    button.style.width = Math.max(w, 1) + 'px';
                    button.style.top = (node._depth * FLAME_ROW) + 'px';
                    button.style.background = flameColor(node);
                    if (w > 30) { button.textContent = node.name; }
                    button.setAttribute('aria-label', node.name + ' — ' + flameMs(node.ms) + ' (' + prettyNumber(node.pct, 1) + ' %)');
                    button.setAttribute('data-i', String(flame.nodes.length));
                    // Les rectangles étroits ne sont pas atteignables au clavier (trop nombreux)
                    if (w < 30) { button.tabIndex = -1; }
                    flame.nodes.push(node);
                    chart.appendChild(button);
                }

                // Parents du zoom : sur toute la largeur, atténués
                for (var parent = zoom._parent; parent !== null; parent = parent._parent) { draw(parent, 0, width, true); }
                (function walk(node) {
                    var w = node.value * scale;
                    // Moins d'un pixel : ni le nœud ni ses enfants (plus petits) ne sont visibles
                    if (w < 1) { return; }
                    draw(node, (node.start - zoom.start) * scale, w, false);
                    depthMax = Math.max(depthMax, node._depth);
                    node.children.forEach(walk);
                })(zoom);
                chart.style.height = ((depthMax + 1) * FLAME_ROW) + 'px';

                renderFlameAxis(width);
                renderFlameCrumbs();
                renderFlameDetail(zoom);
                applyFlameSearch();
            }

            // Mode chronologique : graduations en ms sur la plage affichée
            function renderFlameAxis(width) {
                var axis = $('flameAxis');
                axis.classList.toggle('hidden', codeMode !== 'time');
                axis.innerHTML = '';
                if (codeMode !== 'time') { return; }
                var period = flame.data.summary.period_ms;
                var ticks = Math.max(2, Math.min(10, Math.floor(width / 110)));
                for (var i = 0; i < ticks; i++) {
                    var samples = flame.zoom.start + flame.zoom.value * i / ticks;
                    var tick = el('span', null, prettyNumber(samples * period, 1) + ' ms');
                    tick.style.left = (width * i / ticks) + 'px';
                    axis.appendChild(tick);
                }
            }

            function renderFlameCrumbs() {
                var crumbs = $('flameCrumbs');
                crumbs.innerHTML = '';
                var path = [];
                for (var node = flame.zoom; node !== null; node = node._parent) { path.unshift(node); }
                path.forEach(function(node, index) {
                    if (index > 0) { crumbs.appendChild(document.createTextNode('›')); }
                    if (node === flame.zoom) {
                        crumbs.appendChild(el('b', null, node.name));
                        return;
                    }
                    var button = el('button', null, node.name);
                    button.type = 'button';
                    button.addEventListener('click', function() { zoomFlame(node); });
                    crumbs.appendChild(button);
                });
            }

            function zoomFlame(node) {
                flame.zoom = node;
                hideFlameTooltip();
                renderFlame();
            }

            // Détail du nœud zoomé, avec le lien vers ses appelants / appelés (tableau existant)
            function renderFlameDetail(node) {
                var body = $('flameDetailBody');
                body.innerHTML = '';
                $('flameDetail').classList.remove('hidden');
                function row(label, value) {
                    var tr = el('tr');
                    tr.appendChild(el('td', 'req-label', label));
                    var td = el('td');
                    td.appendChild(typeof value === 'string' ? document.createTextNode(value) : value);
                    tr.appendChild(td);
                    body.appendChild(tr);
                }
                row('Fonction', el('span', 'code-fn', node.name));
                if (node.file) { row('Fichier', el('span', 'code-fn', node.file + (node.line ? ':' + node.line : ''))); }
                if (node._parent !== null) { row('Origine', originBadge(node.origin)); }
                row('Temps inclusif', flameMs(node.ms) + ' (' + prettyNumber(node.pct, 1) + ' %)');
                row('Temps propre', flameMs(node.self_ms));
                if (codeMode === 'time') { row('Début', flameMs(node.start * flame.data.summary.period_ms)); }
                if (codeMode === 'diff' && typeof node.delta_ms === 'number') {
                    row('Référence #' + flame.data.compare, flameMs(node.base_ms));
                    row('Écart', (node.delta_ms > 0 ? '+' : '') + flameMs(node.delta_ms));
                }
                var hasGraph = codeData !== null && codeData.edges.some(function(edge) { return edge.caller === node.name || edge.callee === node.name; });
                if (hasGraph) {
                    var button = el('button', 'code-fn-btn', 'Voir les appelants et les appelés');
                    button.type = 'button';
                    button.style.color = '#0b62a3';
                    button.style.textDecoration = 'underline';
                    button.addEventListener('click', function() { selectFunction(node.name); });
                    row('Graphe d\'appels', button);
                }
            }

            // Recherche : surligne les fonctions dont le nom contient le texte saisi
            function applyFlameSearch() {
                var term = $('flameSearch').value.trim().toLowerCase();
                var buttons = $('flameChart').querySelectorAll('.flame-node');
                buttons.forEach(function(button) {
                    var node = flame.nodes[Number(button.getAttribute('data-i'))];
                    var hit = term !== '' && node._parent !== null && node.name.toLowerCase().indexOf(term) !== -1;
                    button.classList.toggle('match', hit);
                    button.classList.toggle('dim', term !== '' && !hit);
                });
                if (term === '' || flame.data === null) {
                    $('flameMatch').textContent = '';
                    return;
                }
                // Temps total des correspondances : un appel imbriqué dans un autre n'est compté qu'une fois
                var total = 0;
                (function walk(node) {
                    if (node._parent !== null && node.name.toLowerCase().indexOf(term) !== -1) {
                        total += node.value;
                        return;
                    }
                    node.children.forEach(walk);
                })(flame.data.tree);
                var root = flame.data.tree;
                $('flameMatch').textContent = (total === 0)
                    ? 'Aucune fonction trouvée'
                    : flameMs(total * root.ms / root.value) + ' (' + prettyNumber(total * 100 / root.value, 1) + ' %) dans les fonctions trouvées';
            }

            function showFlameTooltip(node, event) {
                var tip = $('flameTooltip');
                tip.innerHTML = '';
                tip.appendChild(el('b', null, node.name));
                if (node.file) { tip.appendChild(el('div', null, node.file + (node.line ? ':' + node.line : ''))); }
                tip.appendChild(el('div', null, 'Temps inclusif : ' + flameMs(node.ms) + ' (' + prettyNumber(node.pct, 1) + ' %)'));
                tip.appendChild(el('div', null, 'Temps propre : ' + flameMs(node.self_ms)));
                if (codeMode === 'diff' && typeof node.delta_ms === 'number') {
                    tip.appendChild(el('div', null, 'Référence #' + flame.data.compare + ' : ' + flameMs(node.base_ms)));
                    tip.appendChild(el('div', node.delta_ms > 0 ? 'slower' : 'faster', 'Écart : ' + (node.delta_ms > 0 ? '+' : '') + flameMs(node.delta_ms)));
                }
                tip.classList.remove('hidden');
                moveFlameTooltip(event);
            }

            function moveFlameTooltip(event) {
                var tip = $('flameTooltip');
                var x = event.clientX + 14;
                var y = event.clientY + 14;
                if (x + tip.offsetWidth > window.innerWidth - 8) { x = event.clientX - tip.offsetWidth - 14; }
                if (y + tip.offsetHeight > window.innerHeight - 8) { y = event.clientY - tip.offsetHeight - 14; }
                tip.style.left = Math.max(4, x) + 'px';
                tip.style.top = Math.max(4, y) + 'px';
            }

            function hideFlameTooltip() { $('flameTooltip').classList.add('hidden'); }

            function flameNodeOf(event) {
                var button = event.target.closest('.flame-node');
                return button === null ? null : flame.nodes[Number(button.getAttribute('data-i'))];
            }

            // ----- Navigation entre les vues -----
            function show(name) {
                view = name;
                var isSearch = name === 'search';
                $('viewSearch').classList.toggle('hidden', !isSearch);
                $('viewLogs').classList.toggle('hidden', name !== 'logs');
                $('viewRequest').classList.toggle('hidden', name !== 'request');
                $('viewSql').classList.toggle('hidden', name !== 'sql');
                $('viewExplain').classList.toggle('hidden', name !== 'explain');
                $('viewCode').classList.toggle('hidden', name !== 'code');
                $('searchForm').classList.toggle('hidden', !isSearch);
                $('logsNav').classList.toggle('hidden', isSearch);
                $('searchTitle').classList.toggle('hidden', !isSearch);
                if (isSearch) { $('summary').classList.add('hidden'); }
                // État actif des entrées de navigation (sidebar)
                document.querySelectorAll('#logsNav a').forEach(function(node) {
                    node.classList.toggle('active', (name === 'request' && node.id === 'navRequest')
                        || ((name === 'sql' || name === 'explain') && node.id === 'navSql')
                        || (name === 'code' && node.id === 'navCode')
                        || (name === 'logs' && node.getAttribute('href') === '#logs'));
                });
            }

            function route() {
                var hash = window.location.hash.replace(/^#/, '').split('/');
                if (hash[0] === 'logs') {
                    token = hash[1] || '';
                    $('tokenFilter').classList.toggle('hidden', token === '');
                    $('tokenFilterId').textContent = '#' + token;
                    show('logs');
                    loadLogs();
                } else if (hash[0] === 'request') {
                    requestToken = hash[1] || '';
                    updateRequestNav(requestToken);
                    show('request');
                    loadRequest();
                } else if (hash[0] === 'sql') {
                    sqlToken = hash[1] || '';
                    updateSqlNav(sqlToken);
                    if (sqlToken !== '') { $('sqlBackLink').setAttribute('href', '#request/' + sqlToken); }
                    show('sql');
                    loadSql();
                } else if (hash[0] === 'explain') {
                    explainToken = /^\d+$/.test(hash[1] || '') ? hash[1] : '';
                    explainId = /^\d+$/.test(hash[2] || '') ? hash[2] : '';
                    explainMode = hash[3] === 'analyze' ? 'analyze' : 'explain';
                    if (explainToken !== '') { updateSqlNav(explainToken); }
                    show('explain');
                    loadExplain();
                } else if (hash[0] === 'code') {
                    codeToken = hash[1] || '';
                    codeMode = { flame: 'heavy', time: 'time', diff: 'diff' }[hash[2]] || 'table';
                    codeCompare = (codeMode === 'diff' && /^\d+$/.test(hash[3] || '')) ? hash[3] : '';
                    updateCodeNav(codeToken);
                    if (codeToken !== '') { $('codeBackLink').setAttribute('href', '#request/' + codeToken); }
                    show('code');
                    loadCode();
                } else {
                    show('search');
                    loadSearch();
                }
            }

            function readForm() {
                var data = new FormData($('searchForm'));
                var filters = {};
                data.forEach(function(value, key) { filters[key] = String(value).trim(); });
                return filters;
            }

            $('searchForm').addEventListener('submit', function(event) {
                event.preventDefault();
                searchFilters = readForm();
                if (window.location.hash !== '' && window.location.hash !== '#search') {
                    window.location.hash = '#search';
                } else {
                    loadSearch();
                }
            });

            // Clic sur un onglet : filtre les résultats sur la famille de statut,
            // comme les onglets de la vue des logs — le champ Statut du formulaire
            // de recherche est synchronisé pour refléter le filtre appliqué
            $('searchTabs').addEventListener('click', function(event) {
                var button = event.target.closest('button');
                if (button === null) { return; }
                $('searchForm').elements.status.value = button.getAttribute('data-status');
                searchFilters = readForm();
                document.querySelectorAll('#searchTabs button').forEach(function(node) { node.classList.toggle('active', node === button); });
                if (window.location.hash !== '' && window.location.hash !== '#search') {
                    window.location.hash = '#search';
                } else {
                    loadSearch();
                }
            });

            $('btnSearch').addEventListener('click', function() {
                window.location.hash = '#search';
                $('searchForm').querySelector('input').focus();
            });

            $('btnLast10').addEventListener('click', function() {
                $('searchForm').reset();
                $('searchForm').elements.limit.value = '10';
                searchFilters = { limit: 10 };
                if (view === 'search') { loadSearch(); } else { window.location.hash = '#search'; }
            });

            $('btnLatest').addEventListener('click', function() {
                query({ limit: 1 }).then(function(data) {
                    if (data.logs.length > 0) { window.location.hash = '#logs/' + data.logs[0].id; }
                }).catch(fail);
            });

            $('tabs').addEventListener('click', function(event) {
                var button = event.target.closest('button');
                if (button === null) { return; }
                logsStatus = button.getAttribute('data-status');
                document.querySelectorAll('#tabs button').forEach(function(node) { node.classList.toggle('active', node === button); });
                loadLogs();
            });

            $('codeFilters').addEventListener('change', function() { if (codeData !== null) { renderCodeTable(); } });

            $('codeTable').querySelector('thead').addEventListener('click', function(event) {
                var th = event.target.closest('th.sortable');
                if (th === null || codeData === null) { return; }
                codeSort = th.getAttribute('data-sort');
                renderCodeTable();
            });

            // ----- Flamegraph : onglets, zoom, recherche et infobulle -----
            $('codeModes').addEventListener('click', function(event) {
                var button = event.target.closest('button');
                if (button === null || codeToken === '') { return; }
                window.location.hash = codeHash(button.getAttribute('data-mode'), codeCompare);
            });

            $('flameCompareSelect').addEventListener('change', function() {
                window.location.hash = codeHash('diff', this.value);
            });

            $('flameChart').addEventListener('click', function(event) {
                var node = flameNodeOf(event);
                if (node !== null && node !== flame.zoom) { zoomFlame(node); }
            });
            $('flameChart').addEventListener('mouseover', function(event) {
                var node = flameNodeOf(event);
                if (node !== null) { showFlameTooltip(node, event); }
            });
            $('flameChart').addEventListener('mousemove', function(event) {
                if (!$('flameTooltip').classList.contains('hidden')) { moveFlameTooltip(event); }
            });
            $('flameChart').addEventListener('mouseleave', hideFlameTooltip);

            $('flameReset').addEventListener('click', function() {
                if (flame.data !== null) { zoomFlame(flame.data.tree); }
            });
            $('flameSearch').addEventListener('input', function() { if (flame.data !== null) { applyFlameSearch(); } });

            // Échap : revient au niveau précédent (sauf dans un champ de saisie)
            document.addEventListener('keydown', function(event) {
                if (event.key !== 'Escape' || view !== 'code' || codeMode === 'table' || flame.zoom === null || flame.data === null) { return; }
                if (event.target.closest('input, select, textarea') !== null) { return; }
                if (flame.zoom._parent !== null) { zoomFlame(flame.zoom._parent); }
            });

            // Largeur de la fenêtre modifiée : le flamegraph est redessiné
            var flameResize = null;
            window.addEventListener('resize', function() {
                clearTimeout(flameResize);
                flameResize = setTimeout(function() {
                    if (view === 'code' && codeMode !== 'table' && flame.data !== null) { renderFlame(); }
                }, 150);
            });

            window.addEventListener('hashchange', route);
            route();
        })();
    </script>
</body>
</html>
