<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Profiler | Edu Framework</title>
    <style>
        html, body { height: 100%; margin: 0; }

        body {
            font-family: 'Open Sans', Helvetica, Arial, sans-serif;
            font-size: 14px;
            color: #222;
            background-color: #f9f9f9;
            display: flex;
            flex-direction: column;
            -webkit-font-smoothing: antialiased;
        }

        a { color: #0e6db5; text-decoration: none; }
        a:hover { text-decoration: underline; }

        /* ===== Barre supérieure ===== */
        .topbar {
            height: 54px;
            background-color: #222;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 20px;
            flex-shrink: 0;
        }

        .topbar .brand { display: flex; align-items: center; gap: 12px; font-size: 22px; font-weight: 600; }
        .topbar .brand span { font-weight: normal; color: #aaa; }
        .topbar .meta { display: flex; align-items: center; gap: 14px; font-size: 12px; color: #aaa; }

        .badge-env {
            background-color: #4f805d;
            color: #fff;
            padding: 2px 8px;
            border-radius: 3px;
            font-weight: bold;
            text-transform: uppercase;
        }

        .btn {
            font-family: inherit;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            color: #fff;
            background-color: #666;
            border: 0;
            border-radius: 2px;
            padding: 6px 12px;
            text-decoration: none;
            display: inline-block;
        }

        .btn:hover { background-color: #777; text-decoration: none; }

        /* ===== Bandeau de la requête (vert / orange / rouge selon le statut) ===== */
        .summary { padding: 14px 20px 12px; color: #fff; background-color: #4f805d; flex-shrink: 0; }
        .summary.s-3xx { background-color: #3a7d8c; }
        .summary.s-4xx { background-color: #a46a1f; }
        .summary.s-5xx { background-color: #b0413e; }
        .summary h2 { margin: 0 0 10px; font-size: 24px; font-weight: 600; word-break: break-all; }
        .summary .meta { display: flex; gap: 22px; flex-wrap: wrap; font-size: 12px; }
        .summary .meta b { opacity: 0.8; margin-right: 4px; }

        .page-title { padding: 14px 20px; background-color: #e0e0e0; border-bottom: 1px solid #ccc; flex-shrink: 0; }
        .page-title h2 { margin: 0; font-size: 24px; font-weight: normal; }

        /* ===== Corps : sidebar + contenu ===== */
        .layout { display: flex; flex: 1; min-height: 0; }

        .sidebar {
            width: 220px;
            background-color: #444;
            color: #ccc;
            flex-shrink: 0;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
        }

        .sidebar .shortcuts { display: flex; gap: 8px; padding: 10px; background-color: #333; }
        .sidebar .shortcuts .btn { padding: 5px 9px; font-size: 12px; white-space: nowrap; }

        .sidebar nav a {
            color: #ddd;
            font-size: 15px;
            padding: 11px 14px;
            display: flex;
            align-items: center;
            gap: 10px;
            border-bottom: 1px solid #3a3a3a;
        }

        .sidebar nav a:hover:not(.disabled) { background-color: #555; text-decoration: none; }
        .sidebar nav a.active { background-color: #666; color: #fff; }
        .sidebar nav a.disabled { color: #777; cursor: not-allowed; }
        .sidebar nav .ico { width: 22px; text-align: center; }
        .sidebar nav .ico svg { vertical-align: -2px; }
        .sidebar nav .count { margin-left: auto; background-color: #e0e0e0; color: #444; font-size: 11px; padding: 1px 7px; border-radius: 3px; font-weight: bold; }

        .sidebar form { padding: 14px 10px; display: flex; flex-direction: column; gap: 10px; }
        .sidebar form label { display: flex; align-items: center; font-size: 13px; color: #ddd; }
        .sidebar form label span { width: 62px; flex-shrink: 0; }
        .sidebar form input, .sidebar form select {
            flex: 1;
            min-width: 0;
            font-family: inherit;
            font-size: 13px;
            padding: 5px 6px;
            border: 0;
            background-color: #ccc;
            color: #222;
        }

        .sidebar form .actions { text-align: right; }

        .sidebar .sidebar-footer { margin-top: auto; padding: 10px 14px; font-size: 11px; color: #888; border-top: 1px solid #3a3a3a; }

        .content { flex: 1; overflow-y: auto; padding: 20px; }
        .content h1 { margin: 0 0 18px; font-size: 26px; font-weight: normal; }
        .hidden { display: none !important; }

        /* ===== Onglets avec compteurs ===== */
        .tabs { display: flex; margin-bottom: 20px; }
        .tabs button {
            font-family: inherit;
            font-size: 16px;
            cursor: pointer;
            padding: 8px 14px;
            color: #444;
            background-color: #fff;
            border: 1px solid #ddd;
            border-right: 0;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .tabs button:last-child { border-right: 1px solid #ddd; }
        .tabs button:hover { background-color: #f3f3f3; }
        .tabs button.active { background-color: #666; border-color: #666; color: #fff; }
        .tabs button .count { background-color: #e8e8e8; color: #555; font-size: 12px; padding: 1px 7px; border-radius: 3px; }
        .tabs button.active .count { background-color: #222; color: #fff; }
        .tabs button.empty { color: #999; }

        /* ===== Tables ===== */
        table.profiler-table { width: 100%; border-collapse: collapse; background-color: #fff; border: 1px solid #ddd; }
        .profiler-table th { text-align: left; padding: 10px 12px; background-color: #e0e0e0; font-size: 15px; }
        .profiler-table td { padding: 12px; border-top: 1px solid #e5e5e5; vertical-align: top; }
        .profiler-table td.time { color: #777; font-size: 13px; white-space: nowrap; }
        .profiler-table td.nowrap { white-space: nowrap; }
        .profiler-table td.channel { font-weight: bold; font-size: 13px; }
        .profiler-table td.empty-state { text-align: center; color: #999; padding: 40px 0; }
        .profiler-table tr.raw td { color: #999; font-style: italic; }
        .profiler-table tr.log-row.highlight td { background-color: #fffbe6; }

        .log-context { margin-top: 6px; font-size: 12px; color: #777; word-break: break-all; }
        .log-context b { color: #444; }
        .log-context pre {
            margin: 6px 0 0;
            padding: 8px 10px;
            background-color: #f5f5f5;
            border: 1px solid #e0e0e0;
            font-size: 12px;
            white-space: pre-wrap;
            font-family: 'SFMono-Regular', Consolas, monospace;
            color: #333;
        }

        /* ===== Vue descriptif d'une requête ===== */
        .profiler-table td.req-label { width: 170px; white-space: nowrap; color: #777; font-weight: 600; }
        #requestBody pre {
            margin: 0;
            padding: 8px 10px;
            background-color: #f5f5f5;
            border: 1px solid #e0e0e0;
            font-size: 12px;
            white-space: pre-wrap;
            word-break: break-all;
            font-family: 'SFMono-Regular', Consolas, monospace;
            color: #333;
        }
        #requestBody pre.error-message {
            background-color: #fbeceb;
            border-color: #e6b5b3;
            color: #b0413e;
        }

        /* ===== Vue requêtes SQL ===== */
        .sql-meta { margin: 0 0 16px; font-size: 14px; color: #555; }
        .sql-meta b { color: #222; }
        .sql-query {
            margin: 0;
            padding: 8px 10px;
            background-color: #f5f5f5;
            border: 1px solid #e0e0e0;
            font-size: 12px;
            white-space: pre-wrap;
            word-break: break-all;
            font-family: 'SFMono-Regular', Consolas, monospace;
            color: #333;
        }
        .sql-group-badge {
            display: inline-block;
            margin-top: 4px;
            font-size: 11px;
            font-weight: bold;
            padding: 2px 6px;
            border-radius: 3px;
            background-color: #e0e0e0;
            color: #444;
            white-space: nowrap;
        }
        .sql-duration { font-weight: bold; white-space: nowrap; }
        .sql-duration.medium { color: #a46a1f; }
        .sql-duration.slow { color: #b0413e; }
        #sidebarSqlCount:empty { display: none; }

        /* ===== Badges ===== */
        .m-GET, .m-POST, .m-PUT, .m-DELETE, .m-PATCH, .m-OTHER { font-weight: bold; font-size: 12px; padding: 1px 6px; border-radius: 3px; color: #000; background-color: #ddd; }
        .m-GET { background-color: #61affe; }
        .m-POST { background-color: #ffc862; }
        .m-PUT { background-color: #fca02f; }
        .m-DELETE { background-color: #f93e3e; color: #fff; }
        .m-PATCH { background-color: #50e3c2; }

        .sapi-badge { display: inline-block; font-size: 11px; font-weight: bold; padding: 2px 6px; border-radius: 3px; background-color: #e0e0e0; color: #555; white-space: nowrap; }
        .sapi-badge.cli-server { background-color: #cfe2ff; color: #0b4f8a; }
        .sapi-badge.frankenphp { background-color: #d7f0dd; color: #1f6b3a; }

        .status-badge { display: inline-block; min-width: 38px; text-align: center; font-weight: bold; color: #fff; padding: 4px 8px; border-radius: 2px; background-color: #4f805d; }
        .status-badge.s-3xx { background-color: #3a7d8c; }
        .status-badge.s-4xx { background-color: #a46a1f; }
        .status-badge.s-5xx { background-color: #b0413e; }
        .status-text.s-2xx { color: #4f805d; }
        .status-text.s-3xx { color: #3a7d8c; }
        .status-text.s-4xx { color: #a46a1f; }
        .status-text.s-5xx { color: #b0413e; }
        .status-text { font-weight: bold; }

        .back-link { margin-bottom: 14px; }
        /* Onglet Code : profiler du code PHP (Excimer) */
        .code-filters { display: flex; flex-wrap: wrap; gap: 14px; margin: 0 0 14px; font-size: 14px; }
        .code-filters label { display: flex; align-items: center; gap: 6px; cursor: pointer; }
        .code-note { margin: 0 0 16px; font-size: 13px; color: #777; }
        .code-actions { margin: 0 0 16px; display: flex; gap: 10px; flex-wrap: wrap; }
        .origin-badge { display: inline-block; padding: 2px 6px; border-radius: 2px; font-size: 12px; font-weight: bold; white-space: nowrap; background: #eee; color: #555; }
        .origin-badge.app { background: #fff1c2; color: #7a5b00; }
        .origin-badge.framework { background: #cfe2ff; color: #0b4f8a; }
        .origin-badge.vendor { background: #e8e0f5; color: #5a3d8a; }
        #codeBody tr.app td { background: #fffbea; }
        #codeBody tr { cursor: pointer; }
        #codeBody tr.selected td { background: #e8f0fe; }
        .code-fn { font-family: monospace; font-size: 13px; word-break: break-all; }
        .code-file { display: block; color: #888; font-size: 12px; font-family: monospace; word-break: break-all; }
        .code-bar { display: inline-block; height: 6px; background: #4f805d; border-radius: 3px; vertical-align: middle; margin-right: 6px; }
        .profiler-table th.sortable { cursor: pointer; user-select: none; }
        .profiler-table th.sortable.sorted::after { content: ' \25BE'; }
        #codeGraph { margin-top: 24px; }
        #codeGraph h2 { font-size: 16px; margin: 0 0 10px; }
        .code-graph-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
        .code-graph-cols h3 { font-size: 13px; text-transform: uppercase; color: #777; margin: 0 0 6px; }
        .code-graph-cols a { cursor: pointer; }
        .profiled-badge { display: inline-block; margin-left: 6px; padding: 1px 5px; border-radius: 2px; font-size: 11px; background: #fff1c2; color: #7a5b00; text-decoration: none; }
        @media (max-width: 800px) { .code-graph-cols { grid-template-columns: 1fr; } }
    </style>
</head>
<body>
    <header class="topbar">
        <div class="brand">
            <img src="{{ logoEF }}" alt="Logo Edu Framework" width="30px">
            <div>Edu Framework <span>Profiler</span></div>
        </div>
        <div class="meta">
            <span class="badge-env">{{ appEnv }}</span>
            <span>{{ version }}</span>
            <span>PHP {{ phpVersion }}</span>
            <a class="btn" href="https://studoo-app.github.io/edu-framework" target="_blank" rel="noopener">Documentation</a>
        </div>
    </header>

    <section class="summary" id="summary">
        <h2 id="summaryUrl"></h2>
        <div class="meta">
            <span><b>M&eacute;thode :</b> <span id="summaryMethod"></span></span>
            <span><b>Statut HTTP :</b> <span id="summaryStatus"></span></span>
            <span><b>IP :</b> <span id="summaryIp"></span></span>
            <span><b>Serveur (SAPI) :</b> <span id="summarySapi"></span></span>
            <span><b>Dur&eacute;e :</b> <span id="summaryDuration"></span></span>
            <span><b>M&eacute;moire :</b> <span id="summaryMemory"></span></span>
            <span><b>Re&ccedil;ue le :</b> <span id="summaryDate"></span></span>
            <span><b>Token :</b> <span id="summaryToken"></span></span>
        </div>
    </section>

    <section class="page-title" id="searchTitle"><h2>Recherche de requ&ecirc;tes</h2></section>

    <div class="layout">
        <aside class="sidebar">
            <div class="shortcuts">
                <button type="button" class="btn" id="btnLast10">10 derniers</button>
                <button type="button" class="btn" id="btnLatest">Dernier</button>
                <button type="button" class="btn" id="btnSearch" title="Recherche">&#128269;</button>
            </div>

            <nav id="logsNav">
                <a href="#" id="navRequest" class="disabled" title="Ouvrez le descriptif d'une requ&ecirc;te depuis la barre de debug ou la recherche"><span class="ico">&#9881;</span> Requ&ecirc;te</a>
                <a href="#" id="navSql" class="disabled" title="Ouvrez le descriptif d'une requ&ecirc;te puis cliquez sur la ligne Requ&ecirc;tes SQL"><span class="ico"><svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><ellipse cx="8" cy="3.75" rx="5.5" ry="2.25"/><path d="M2.5 3.75v8.5c0 1.24 2.46 2.25 5.5 2.25s5.5-1.01 5.5-2.25v-8.5"/><path d="M2.5 8c0 1.24 2.46 2.25 5.5 2.25S13.5 9.24 13.5 8"/></svg></span> SQL <span id="sidebarSqlCount" class="count"></span></a>
                <a href="#" id="navCode" class="disabled" title="Activez le profilage avec le bloc Code de la barre de debug, puis ouvrez le profil d'une requ&ecirc;te"><span class="ico">&#9201;</span> Code</a>
                <a href="#logs" class="active"><span class="ico">&#9776;</span> Logs <span id="sidebarCount" class="count">0</span></a>
            </nav>

            <form id="searchForm" autocomplete="off">
                <label><span>IP</span><input type="text" name="ip"></label>
                <label><span>M&eacute;thode</span>
                    <select name="method">
                        <option value="">Toutes</option>
                        <option>GET</option>
                        <option>POST</option>
                        <option>PUT</option>
                        <option>DELETE</option>
                        <option>PATCH</option>
                    </select>
                </label>
                <label><span>Statut</span><input type="text" name="status" inputmode="numeric" placeholder="500"></label>
                <label><span>SAPI</span>
                    <select name="sapi">
                        <option value="">Toutes</option>
                        <option>cli-server</option>
                        <option>frankenphp</option>
                    </select>
                </label>
                <label><span>URL</span><input type="text" name="url"></label>
                <label><span>Token</span><input type="text" name="token" inputmode="numeric"></label>
                <label><span>Depuis</span><input type="date" name="from"></label>
                <label><span>Jusqu'au</span><input type="date" name="until"></label>
                <label><span>R&eacute;sultats</span>
                    <select name="limit">
                        <option>10</option>
                        <option selected>20</option>
                        <option>50</option>
                        <option>100</option>
                    </select>
                </label>
                <div class="actions"><button type="submit" class="btn">Rechercher</button></div>
            </form>

            <div class="sidebar-footer">
                Les logs sont enregistr&eacute;s dans <code>var/logs/core_logs.sqlite</code>
            </div>
        </aside>

        <main class="content">
            <!-- Vue : résultats de recherche -->
            <div id="viewSearch">
                <h1 id="searchTotal"></h1>

                <!-- Filtres par famille de statut : mêmes onglets que la vue des logs -->
                <div class="tabs" id="searchTabs">
                    <button type="button" data-status="" class="active">Tous <span class="count" data-count="all">0</span></button>
                    <button type="button" data-status="2">2xx <span class="count" data-count="2">0</span></button>
                    <button type="button" data-status="3">3xx <span class="count" data-count="3">0</span></button>
                    <button type="button" data-status="4">4xx <span class="count" data-count="4">0</span></button>
                    <button type="button" data-status="5">5xx <span class="count" data-count="5">0</span></button>
                </div>

                <table class="profiler-table">
                    <thead>
                        <tr>
                            <th>Statut</th><th>IP</th><th>M&eacute;thode</th><th>URL</th><th>SAPI</th><th>Date</th><th>Token</th>
                        </tr>
                    </thead>
                    <tbody id="searchBody"></tbody>
                </table>
            </div>

            <!-- Vue : messages de log -->
            <div id="viewLogs" class="hidden">
                <h1>Messages de log</h1>
                <div class="back-link hidden" id="tokenFilter">
                    Requ&ecirc;te <b id="tokenFilterId"></b> uniquement &mdash; <a href="#logs">afficher tous les logs</a>
                </div>
                <div class="tabs" id="tabs">
                    <button type="button" data-status="" class="active">Tous <span class="count" data-count="all">0</span></button>
                    <button type="button" data-status="2">2xx <span class="count" data-count="2">0</span></button>
                    <button type="button" data-status="3">3xx <span class="count" data-count="3">0</span></button>
                    <button type="button" data-status="4">4xx <span class="count" data-count="4">0</span></button>
                    <button type="button" data-status="5">5xx <span class="count" data-count="5">0</span></button>
                </div>
                <table class="profiler-table">
                    <thead>
                        <tr><th>Heure</th><th>Canal</th><th>Message</th></tr>
                    </thead>
                    <tbody id="logsBody"></tbody>
                </table>
            </div>

            <!-- Vue : descriptif d'une requête HTTP -->
            <div id="viewRequest" class="hidden">
                <div class="back-link"><a href="#search">&#8592; Retour &agrave; la recherche</a></div>
                <h1 id="requestTitle"></h1>
                <table class="profiler-table">
                    <tbody id="requestBody"></tbody>
                </table>
            </div>

            <!-- Vue : requêtes SQL d'une requête HTTP -->
            <div id="viewSql" class="hidden">
                <div class="back-link"><a href="#request" id="sqlBackLink">&#8592; Retour au descriptif de la requ&ecirc;te</a></div>
                <h1 id="sqlTitle"></h1>
                <div class="sql-meta" id="sqlMeta"></div>
                <table class="profiler-table">
                    <thead>
                        <tr><th>#</th><th>Requ&ecirc;te SQL</th><th>Dur&eacute;e</th><th>Lignes</th><th>Heure</th></tr>
                    </thead>
                    <tbody id="sqlBody"></tbody>
                </table>
            </div>
            <!-- Vue : profil du code PHP exécuté pendant une requête HTTP -->
            <div id="viewCode" class="hidden">
                <div class="back-link"><a href="#request" id="codeBackLink">&#8592; Retour au descriptif de la requ&ecirc;te</a></div>
                <h1 id="codeTitle"></h1>
                <div class="sql-meta" id="codeMeta"></div>
                <p class="code-note">Les temps sont estim&eacute;s par &eacute;chantillonnage : la pile d'appels est relev&eacute;e &agrave; intervalle r&eacute;gulier. Le <b>temps propre</b> est pass&eacute; dans la fonction elle-m&ecirc;me (y compris les fonctions natives de PHP qu'elle appelle), le <b>temps inclusif</b> compte aussi les fonctions qu'elle appelle. Une fonction plus courte que la p&eacute;riode peut ne pas appara&icirc;tre.</p>
                <div class="code-actions" id="codeActions">
                    <a class="btn" id="codeSpeedscope" href="#" download>T&eacute;l&eacute;charger le flamegraph (Speedscope)</a>
                    <a class="btn" href="https://www.speedscope.app" target="_blank" rel="noopener">Ouvrir speedscope.app</a>
                </div>
                <div class="code-filters" id="codeFilters">
                    <label><input type="checkbox" value="app" checked> Mon code (app/)</label>
                    <label><input type="checkbox" value="framework"> Framework</label>
                    <label><input type="checkbox" value="vendor"> D&eacute;pendances (vendor/)</label>
                    <label><input type="checkbox" value="other"> Autre</label>
                </div>
                <table class="profiler-table" id="codeTable">
                    <thead>
                        <tr>
                            <th>Fonction</th><th>Origine</th>
                            <th class="sortable sorted" data-sort="self">Temps propre</th>
                            <th class="sortable" data-sort="inclusive">Temps inclusif</th>
                        </tr>
                    </thead>
                    <tbody id="codeBody"></tbody>
                </table>
                <div id="codeGraph" class="hidden">
                    <h2 id="codeGraphTitle"></h2>
                    <div class="code-graph-cols">
                        <div><h3>Appel&eacute;e par</h3><table class="profiler-table"><tbody id="codeCallers"></tbody></table></div>
                        <div><h3>Appelle</h3><table class="profiler-table"><tbody id="codeCallees"></tbody></table></div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script>
        (function() {
            var CONTEXT_MAX = 80;
            var view = 'search';
            var token = '';
            var requestToken = '';
            var sqlToken = '';
            var codeToken = '';
            var codeData = null;
            var codeSort = 'self';
            var codeSelected = null;
            var logsStatus = '';
            var searchFilters = { limit: 20 };

            function $(id) { return document.getElementById(id); }
            function el(tag, className, text) {
                var node = document.createElement(tag);
                if (className) { node.className = className; }
                if (text !== undefined && text !== null) { node.textContent = text; }
                return node;
            }

            function statusClass(code) { return 's-' + String(code).charAt(0) + 'xx'; }
            function methodBadge(method) {
                var known = ['GET', 'POST', 'PUT', 'DELETE', 'PATCH'];
                return el('span', 'm-' + (known.indexOf(method) === -1 ? 'OTHER' : method), method);
            }
            function sapiBadge(sapi) {
                if (sapi === undefined || sapi === null || sapi === '') { return document.createTextNode('\u2014'); }
                var known = ['cli-server', 'frankenphp'];
                return el('span', 'sapi-badge' + (known.indexOf(sapi) === -1 ? '' : ' ' + sapi), sapi);
            }
            function prettyNumber(value, decimals) {
                return Number(value).toFixed(decimals).replace('.', ',');
            }
            function prettyDuration(executionTimeMs) {
                return (executionTimeMs === undefined || executionTimeMs === null)
                    ? '\u2014' : prettyNumber(executionTimeMs, 1) + ' ms';
            }
            function prettyMemory(memoryMb) {
                return (memoryMb === undefined || memoryMb === null)
                    ? '\u2014' : prettyNumber(memoryMb, 2) + ' Mo';
            }
            function isHttp(log) { return log.event && log.event.method !== undefined && log.event.method !== null; }
            function requestLink(id, label) {
                var link = el('a', null, label);
                link.href = '#request/' + id;
                return link;
            }
            function timeOf(log) {
                var match = /\d{2}:\d{2}:\d{2}/.exec((log.event && log.event.timestamp) || log.event_date || '');
                return match ? match[0] : '';
            }

            function query(params) {
                var url = new URLSearchParams();
                Object.keys(params).forEach(function(key) {
                    if (params[key] !== '' && params[key] !== undefined && params[key] !== null) { url.set(key, params[key]); }
                });
                return fetch('/edu-logs?' + url.toString()).then(function(response) { return response.json(); });
            }

            function sqlQuery(params) {
                var url = new URLSearchParams();
                Object.keys(params).forEach(function(key) {
                    if (params[key] !== '' && params[key] !== undefined && params[key] !== null) { url.set(key, params[key]); }
                });
                return fetch('/edu-sql-logs?' + url.toString()).then(function(response) { return response.json(); });
            }

            function codeQuery(params) {
                var url = new URLSearchParams();
                Object.keys(params).forEach(function(key) {
                    if (params[key] !== '' && params[key] !== undefined && params[key] !== null) { url.set(key, params[key]); }
                });
                return fetch('/edu-code-profile?' + url.toString()).then(function(response) { return response.json(); });
            }

            function fail(error) { console.error('[EduFramework Profiler]', error); }

            // ----- Contexte d'un log : tronqué si long, complet au clic ("Show full context") -----
            function contextOf(log) {
                var context = {};
                Object.keys(log.event || {}).forEach(function(key) {
                    if (key !== 'path' && key !== 'raw') { context[key] = log.event[key]; }
                });
                return context;
            }

            function buildContext(log) {
                var context = contextOf(log);
                var inline = Object.keys(context).map(function(key) {
                    if (key === 'execution_time_ms') { return key + ' => ' + prettyDuration(context[key]); }
                    if (key === 'memory_mb') { return key + ' => ' + prettyMemory(context[key]); }
                    return key + ' => ' + context[key];
                }).join(', ');
                var box = el('div', 'log-context');
                box.appendChild(el('b', null, 'Contexte : '));

                if (inline.length <= CONTEXT_MAX) {
                    box.appendChild(document.createTextNode('[ ' + inline + ' ]'));
                    return box;
                }

                var short = el('span', null, '[ ' + inline.substring(0, CONTEXT_MAX) + ' ... ');
                var link = el('a', null, 'Afficher le contexte complet');
                link.href = '#';
                var full = el('pre', 'hidden', JSON.stringify(log.event, null, 2));
                link.addEventListener('click', function(event) {
                    event.preventDefault();
                    var open = full.classList.toggle('hidden') === false;
                    link.textContent = open ? 'Masquer le contexte' : 'Afficher le contexte complet';
                });
                short.appendChild(link);
                box.appendChild(short);
                box.appendChild(full);
                return box;
            }

            // ----- Vue "messages de log" -----
            function renderSummary(log) {
                var summary = $('summary');
                if (!log || !isHttp(log)) {
                    summary.classList.add('hidden');
                    return;
                }
                summary.classList.remove('hidden');
                summary.className = 'summary ' + statusClass(log.event.status_code);
                $('summaryUrl').textContent = log.event.path;
                $('summaryMethod').textContent = log.event.method;
                $('summaryStatus').textContent = log.event.status_code;
                $('summaryIp').textContent = log.event.ip_port;
                $('summarySapi').textContent = log.event.sapi || '\u2014';
                $('summaryDuration').textContent = prettyDuration(log.event.execution_time_ms);
                $('summaryMemory').textContent = prettyMemory(log.event.memory_mb);
                $('summaryDate').textContent = log.event.timestamp;
                $('summaryToken').textContent = '#' + log.id;
            }

            // Badges de compteur des onglets par famille de statut,
            // partagés entre les vues Logs et Recherche
            function renderCountBadges(container, counts) {
                container.querySelectorAll('[data-count]').forEach(function(node) {
                    var value = counts[node.getAttribute('data-count')] || 0;
                    node.textContent = value;
                    node.parentNode.classList.toggle('empty', value === 0);
                });
            }

            function renderCounts(counts) {
                renderCountBadges($('tabs'), counts);
                $('sidebarCount').textContent = counts.all || 0;
            }

            function renderLogs(data) {
                var body = $('logsBody');
                body.innerHTML = '';
                renderCounts(data.counts);

                if (data.logs.length === 0) {
                    var tr = el('tr');
                    var td = el('td', 'empty-state', 'Aucun log dans cette cat\u00e9gorie');
                    td.colSpan = 3;
                    tr.appendChild(td);
                    body.appendChild(tr);
                }

                data.logs.forEach(function(log) {
                    var tr = el('tr', isHttp(log) ? 'log-row' : 'raw');
                    tr.appendChild(el('td', 'time', timeOf(log)));

                    if (isHttp(log)) {
                        var tdChannel = el('td', 'channel');
                        tdChannel.appendChild(methodBadge(log.event.method));
                        tdChannel.appendChild(document.createTextNode(' '));
                        tdChannel.appendChild(sapiBadge(log.event.sapi));
                        tr.appendChild(tdChannel);

                        var tdMessage = el('td');
                        tdMessage.appendChild(requestLink(log.id, log.event.path));
                        tdMessage.appendChild(document.createTextNode(' \u2192 '));
                        tdMessage.appendChild(el('span', 'status-text ' + statusClass(log.event.status_code), log.event.status_code));
                        tdMessage.appendChild(buildContext(log));
                        tr.appendChild(tdMessage);
                    } else {
                        tr.appendChild(el('td', 'channel', 'raw'));
                        tr.appendChild(el('td', null, log.event.raw));
                    }
                    body.appendChild(tr);
                });
            }

            function loadLogs() {
                query({ limit: 20, status: logsStatus, token: token }).then(function(data) {
                    renderLogs(data);
                    if (token !== '') {
                        renderSummary(data.logs[0]);
                    } else {
                        return query({ limit: 1 }).then(function(latest) { renderSummary(latest.logs[0]); });
                    }
                }).catch(fail);
            }

            // ----- Vue "recherche" -----
            // Onglets de filtrage par famille de statut, comme la vue des logs :
            // mêmes compteurs serveur (data.counts, indépendants du filtre de statut)
            // et même état actif (famille filtrée via le champ Statut du formulaire)
            function renderSearchTabs(counts) {
                renderCountBadges($('searchTabs'), counts || {});
                var status = searchFilters.status || '';
                document.querySelectorAll('#searchTabs button').forEach(function(node) {
                    node.classList.toggle('active', node.getAttribute('data-status') === status);
                });
            }

            function renderSearch(data) {
                var body = $('searchBody');
                body.innerHTML = '';
                $('searchTotal').textContent = data.total + (data.total > 1 ? ' r\u00e9sultats trouv\u00e9s' : ' r\u00e9sultat trouv\u00e9');
                renderSearchTabs(data.counts);

                if (data.logs.length === 0) {
                    var tr = el('tr');
                    var td = el('td', 'empty-state', 'Aucune requ\u00eate ne correspond \u00e0 cette recherche');
                    td.colSpan = 7;
                    tr.appendChild(td);
                    body.appendChild(tr);
                }

                data.logs.forEach(function(log) {
                    var tr = el('tr');
                    if (!isHttp(log)) {
                        var tdRaw = el('td', null, log.event.raw);
                        tdRaw.colSpan = 6;
                        tr.appendChild(tdRaw);
                    } else {
                        var tdStatus = el('td', 'nowrap');
                        tdStatus.appendChild(el('span', 'status-badge ' + statusClass(log.event.status_code), log.event.status_code));
                        tr.appendChild(tdStatus);
                        tr.appendChild(el('td', null, log.event.ip_port));
                        var tdMethod = el('td');
                        tdMethod.appendChild(methodBadge(log.event.method));
                        tr.appendChild(tdMethod);
                        var tdPath = el('td');
                        tdPath.appendChild(requestLink(log.id, log.event.path));
                        if (log.profiled === true) {
                            var badge = el('a', 'profiled-badge', 'profil');
                            badge.href = '#code/' + log.id;
                            badge.title = 'Profil du code de cette requ\u00eate';
                            tdPath.appendChild(badge);
                        }
                        tr.appendChild(tdPath);
                        var tdSapi = el('td', 'nowrap');
                        tdSapi.appendChild(sapiBadge(log.event.sapi));
                        tr.appendChild(tdSapi);
                        tr.appendChild(el('td', 'time', log.event.timestamp));
                    }
                    var tdToken = el('td');
                    var link = el('a', null, '#' + log.id);
                    link.href = '#logs/' + log.id;
                    tdToken.appendChild(link);
                    tr.appendChild(tdToken);
                    body.appendChild(tr);
                });
            }

            function loadSearch() {
                query(searchFilters).then(renderSearch).catch(fail);
            }

            // ----- Vue "descriptif d'une requête" -----
            function updateRequestNav(id) {
                // L'entrée "Requête" de la navigation ne pointe nulle part tant
                // qu'aucune requête n'a été consultée
                var link = $('navRequest');
                if (id) {
                    link.classList.remove('disabled');
                    link.setAttribute('href', '#request/' + id);
                } else {
                    link.classList.add('disabled');
                    link.setAttribute('href', '#');
                }
            }

            function updateSqlNav(id) {
                // L'entrée "SQL" de la navigation suit la dernière requête SQL consultée
                var link = $('navSql');
                if (id) {
                    link.classList.remove('disabled');
                    link.setAttribute('href', '#sql/' + id);
                } else {
                    link.classList.add('disabled');
                    link.setAttribute('href', '#');
                }
            }

            function updateCodeNav(id) {
                // L'entrée "Code" de la navigation suit le dernier profil consulté
                var link = $('navCode');
                if (id) {
                    link.classList.remove('disabled');
                    link.setAttribute('href', '#code/' + id);
                } else {
                    link.classList.add('disabled');
                    link.setAttribute('href', '#');
                }
            }

            function requestRow(label, valueNode) {
                var tr = el('tr');
                tr.appendChild(el('td', 'req-label', label));
                var td = el('td');
                if (typeof valueNode === 'string') { td.textContent = valueNode; } else { td.appendChild(valueNode); }
                tr.appendChild(td);
                return tr;
            }

            function renderRequest(log) {
                var body = $('requestBody');
                body.innerHTML = '';

                if (isHttp(log) === false) {
                    // Log brut (pas une requête HTTP) : on affiche le message seul
                    $('summary').classList.add('hidden');
                    $('requestTitle').textContent = 'Requ\u00eate HTTP';
                    body.appendChild(requestRow('Token', '#' + log.id));
                    body.appendChild(requestRow('Message brut', el('pre', null, log.event.raw || '')));
                    return;
                }

                renderSummary(log);
                $('requestTitle').textContent = 'Requ\u00eate HTTP #' + log.id;
                var e = log.event;

                body.appendChild(requestRow('Token', '#' + log.id));
                body.appendChild(requestRow('M\u00e9thode', methodBadge(e.method)));
                body.appendChild(requestRow('Statut HTTP', el('span', 'status-badge ' + statusClass(e.status_code), e.status_code)));
                body.appendChild(requestRow('URL', (e.path === undefined ? '\u2014' : e.path)));
                body.appendChild(requestRow('IP du client', (e.ip_port === undefined ? '\u2014' : e.ip_port)));
                body.appendChild(requestRow('Serveur (SAPI)', sapiBadge(e.sapi)));
                body.appendChild(requestRow('Dur\u00e9e', prettyDuration(e.execution_time_ms)));
                body.appendChild(requestRow('M\u00e9moire', prettyMemory(e.memory_mb)));
                // Les requêtes SQL de la requête HTTP : le compte est complété
                // par loadRequest() dès que l'API /edu-sql-logs a répondu
                var sqlLink = el('a', null, '\u2014');
                sqlLink.href = '#sql/' + log.id;
                sqlLink.id = 'requestSqlLink';
                body.appendChild(requestRow('Requ\u00eates SQL', sqlLink));
                // Profil du code : présent seulement si la requête a été profilée
                var codeLink = el('a', null, log.profiled === true ? 'Voir le profil du code' : 'Requ\u00eate non profil\u00e9e');
                codeLink.href = '#code/' + log.id;
                codeLink.id = 'requestCodeLink';
                body.appendChild(requestRow('Profil du code', codeLink));
                if (e.error_message !== undefined) {
                    body.appendChild(requestRow('Erreur', el('pre', 'error-message', e.error_message)));
                }
                body.appendChild(requestRow('Re\u00e7ue le', (e.timestamp === undefined ? log.event_date : e.timestamp)));
                body.appendChild(requestRow('Ligne brute', el('pre', null, e.raw || '')));
            }

            function renderRequestEmpty() {
                $('summary').classList.add('hidden');
                $('requestTitle').textContent = 'Requ\u00eate introuvable';
                var body = $('requestBody');
                body.innerHTML = '';
                var tr = el('tr');
                var td = el('td', 'empty-state', 'La requ\u00eate #' + requestToken
                    + ' n\'est plus dans la base des logs (elle a peut-\u00eatre \u00e9t\u00e9 supprim\u00e9e ou la base a \u00e9t\u00e9 r\u00e9initialis\u00e9e)');
                td.colSpan = 2;
                tr.appendChild(td);
                body.appendChild(tr);
            }

            function loadRequest() {
                query({ token: requestToken, limit: 1 }).then(function(data) {
                    if (data.logs.length === 0) {
                        renderRequestEmpty();
                    } else {
                        renderRequest(data.logs[0]);
                        // Complète la ligne "Requêtes SQL" du descriptif avec le compte
                        // et le temps cumulé des requêtes SQL de la requête HTTP
                        sqlQuery({ token: requestToken }).then(function(sql) {
                            var link = $('requestSqlLink');
                            if (link === null) { return; }
                            link.textContent = sql.total === 0
                                ? 'Aucune requ\u00eate SQL'
                                : sql.total + ' requ\u00eate' + (sql.total > 1 ? 's' : '')
                                    + ' \u2014 ' + prettyNumber(sql.total_duration_ms, 1) + ' ms';
                        }).catch(fail);
                    }
                }).catch(fail);
            }

            // ----- Vue "requêtes SQL d'une requête HTTP" -----
            function durationClass(durationMs) {
                if (durationMs > 100) { return 'sql-duration slow'; }
                if (durationMs > 20) { return 'sql-duration medium'; }
                return 'sql-duration';
            }

            function sqlTimeOf(entry) {
                var match = /\d{2}:\d{2}:\d{2}/.exec(entry.event_date || '');
                return match ? match[0] : (entry.event_date || '');
            }

            function renderSql(sqlData, log) {
                var body = $('sqlBody');
                body.innerHTML = '';
                $('sidebarSqlCount').textContent = sqlData.total || 0;
                $('sqlTitle').textContent = sqlData.total + (sqlData.total > 1 ? ' requ\u00eates SQL' : ' requ\u00eate SQL');

                // Totaux : temps SQL cumulé et part du temps de la requête HTTP
                var meta = $('sqlMeta');
                meta.innerHTML = '';
                if (sqlData.total > 0) {
                    meta.appendChild(document.createTextNode('Temps SQL cumul\u00e9 : '));
                    meta.appendChild(el('b', null, prettyNumber(sqlData.total_duration_ms, 1) + ' ms'));
                    var executionTimeMs = (log && log.event && log.event.execution_time_ms !== undefined)
                        ? Number(log.event.execution_time_ms) : 0;
                    if (executionTimeMs > 0) {
                        meta.appendChild(document.createTextNode(
                            ' \u2014 ' + Math.round(sqlData.total_duration_ms / executionTimeMs * 100)
                            + ' % du temps de la requ\u00eate HTTP (' + prettyNumber(executionTimeMs, 1) + ' ms)'
                        ));
                    }
                }

                if (sqlData.queries.length === 0) {
                    var trEmpty = el('tr');
                    var tdEmpty = el('td', 'empty-state', 'Aucune requ\u00eate SQL enregistr\u00e9e pour cette requ\u00eate HTTP');
                    tdEmpty.colSpan = 5;
                    trEmpty.appendChild(tdEmpty);
                    body.appendChild(trEmpty);
                    return;
                }

                // Regroupement des requêtes identiques : badge de nombre d'exécutions
                var groups = {};
                (sqlData.groups || []).forEach(function(group) { groups[group.query] = group; });

                sqlData.queries.forEach(function(entry, index) {
                    var tr = el('tr');
                    tr.appendChild(el('td', 'time', String(index + 1)));

                    var tdQuery = el('td');
                    tdQuery.appendChild(el('pre', 'sql-query', entry.query));
                    var group = groups[entry.query];
                    if (group !== undefined && group.count > 1) {
                        tdQuery.appendChild(el('div', 'sql-group-badge',
                            '\u00d7' + group.count + ' requ\u00eates identiques \u2014 '
                            + prettyNumber(group.duration_ms, 1) + ' ms au total'));
                    }
                    tr.appendChild(tdQuery);

                    tr.appendChild(el('td', durationClass(entry.duration_ms), prettyNumber(entry.duration_ms, 1) + ' ms'));
                    tr.appendChild(el('td', 'time',
                        (entry.rows_count === null || entry.rows_count === undefined) ? '\u2014' : String(entry.rows_count)));
                    tr.appendChild(el('td', 'time', sqlTimeOf(entry)));
                    body.appendChild(tr);
                });
            }

            function loadSql() {
                if (sqlToken === '') {
                    $('summary').classList.add('hidden');
                    renderSql({ token: null, total: 0, total_duration_ms: 0, groups: [], queries: [] }, null);
                    return;
                }

                // Bandeau de la requête (summary) + requêtes SQL : deux appels parallèles
                Promise.all([
                    query({ token: sqlToken, limit: 1 }),
                    sqlQuery({ token: sqlToken })
                ]).then(function(results) {
                    var log = (results[0].logs.length > 0 ? results[0].logs[0] : null);
                    if (log !== null) {
                        renderSummary(log);
                    } else {
                        $('summary').classList.add('hidden');
                    }
                    renderSql(results[1], log);
                }).catch(fail);
            }

            // ----- Vue "profil du code d'une requête HTTP" -----
            function originBadge(origin) {
                var labels = { app: 'mon code', framework: 'framework', vendor: 'vendor', other: 'autre' };
                return el('span', 'origin-badge ' + origin, labels[origin] || origin);
            }

            function codeFilters() {
                var origins = [];
                document.querySelectorAll('#codeFilters input:checked').forEach(function(node) { origins.push(node.value); });
                return origins;
            }

            function timeCell(ms, pct, max) {
                var td = el('td', 'nowrap');
                var bar = el('span', 'code-bar');
                bar.style.width = Math.max(2, Math.round(pct / Math.max(max, 1) * 80)) + 'px';
                td.appendChild(bar);
                td.appendChild(el('b', null, prettyNumber(ms, 2) + ' ms'));
                td.appendChild(document.createTextNode(' (' + prettyNumber(pct, 1) + ' %)'));
                return td;
            }

            function renderCodeEmpty(message) {
                $('codeMeta').innerHTML = '';
                $('codeActions').classList.add('hidden');
                $('codeGraph').classList.add('hidden');
                var body = $('codeBody');
                body.innerHTML = '';
                var tr = el('tr');
                var td = el('td', 'empty-state');
                td.colSpan = 4;
                td.appendChild(document.createTextNode(message + ' '));
                var activate = el('a', null, 'Activer le profilage et rouvrir la page');
                activate.href = '#';
                activate.addEventListener('click', function(event) {
                    event.preventDefault();
                    document.cookie = 'edu_profile=1; path=/; SameSite=Lax';
                    query({ token: codeToken, limit: 1 }).then(function(data) {
                        var path = (data.logs.length > 0 && data.logs[0].event) ? data.logs[0].event.path : '/';
                        window.open(path || '/', '_blank');
                    }).catch(fail);
                });
                td.appendChild(activate);
                tr.appendChild(td);
                body.appendChild(tr);
            }

            function renderCodeTable() {
                var body = $('codeBody');
                body.innerHTML = '';
                var origins = codeFilters();
                var functions = codeData.functions.filter(function(fn) {
                    return origins.indexOf(fn.origin) !== -1 && (fn.self > 0 || fn.inclusive > 0);
                });
                functions.sort(function(a, b) { return b[codeSort] - a[codeSort]; });
                document.querySelectorAll('#codeTable th.sortable').forEach(function(node) {
                    node.classList.toggle('sorted', node.getAttribute('data-sort') === codeSort);
                });

                if (functions.length === 0) {
                    var trEmpty = el('tr');
                    var tdEmpty = el('td', 'empty-state', 'Aucune fonction pour ce filtre : cochez Framework ou Autre pour voir le reste du code ex\u00e9cut\u00e9');
                    tdEmpty.colSpan = 4;
                    trEmpty.appendChild(tdEmpty);
                    body.appendChild(trEmpty);
                    return;
                }

                var maxSelf = Math.max.apply(null, functions.map(function(fn) { return fn.self_pct; }));
                var maxInclusive = Math.max.apply(null, functions.map(function(fn) { return fn.inclusive_pct; }));
                functions.forEach(function(fn) {
                    var tr = el('tr', fn.origin === 'app' ? 'app' : null);
                    if (fn.name === codeSelected) { tr.classList.add('selected'); }
                    var tdName = el('td');
                    tdName.appendChild(el('span', 'code-fn', fn.name));
                    if (fn.file) { tdName.appendChild(el('span', 'code-file', fn.file + (fn.line ? ':' + fn.line : ''))); }
                    tr.appendChild(tdName);
                    var tdOrigin = el('td');
                    tdOrigin.appendChild(originBadge(fn.origin));
                    tr.appendChild(tdOrigin);
                    tr.appendChild(timeCell(fn.self_ms, fn.self_pct, maxSelf));
                    tr.appendChild(timeCell(fn.inclusive_ms, fn.inclusive_pct, maxInclusive));
                    tr.addEventListener('click', function() { selectFunction(fn.name); });
                    body.appendChild(tr);
                });
            }

            function graphRows(target, edges, key) {
                target.innerHTML = '';
                if (edges.length === 0) {
                    var tr = el('tr');
                    tr.appendChild(el('td', 'empty-state', '\u2014'));
                    target.appendChild(tr);
                    return;
                }
                edges.forEach(function(edge) {
                    var tr = el('tr');
                    var td = el('td');
                    var link = el('a', 'code-fn', edge[key]);
                    link.addEventListener('click', function() { selectFunction(edge[key]); });
                    td.appendChild(link);
                    tr.appendChild(td);
                    tr.appendChild(el('td', 'nowrap', prettyNumber(edge.ms, 2) + ' ms'));
                    target.appendChild(tr);
                });
            }

            function selectFunction(name) {
                codeSelected = name;
                renderCodeTable();
                $('codeGraph').classList.remove('hidden');
                $('codeGraphTitle').textContent = name;
                graphRows($('codeCallers'), codeData.edges.filter(function(edge) { return edge.callee === name; }), 'caller');
                graphRows($('codeCallees'), codeData.edges.filter(function(edge) { return edge.caller === name; }), 'callee');
                $('codeGraph').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }

            function renderCode(data) {
                codeSelected = null;
                $('codeGraph').classList.add('hidden');
                $('codeTitle').textContent = 'Profil du code \u2014 requ\u00eate #' + codeToken;
                if (data.status !== 'ready') {
                    codeData = null;
                    renderCodeEmpty('Cette requ\u00eate n\'a pas \u00e9t\u00e9 profil\u00e9e (ou le profil a \u00e9t\u00e9 supprim\u00e9 : seuls les derniers sont conserv\u00e9s).');
                    return;
                }
                codeData = data;
                var meta = $('codeMeta');
                meta.innerHTML = '';
                meta.appendChild(document.createTextNode('Temps profil\u00e9 : '));
                meta.appendChild(el('b', null, prettyNumber(data.summary.wall_ms, 1) + ' ms'));
                meta.appendChild(document.createTextNode(' \u2014 ' + data.summary.samples + ' \u00e9chantillons (1 toutes les '
                    + prettyNumber(data.summary.period_ms, 1) + ' ms) \u2014 ' + data.summary.functions_count + ' fonctions \u2014 m\u00e9moire '
                    + prettyMemory(data.summary.peak_mb) + ' \u2014 driver ' + data.summary.driver));
                $('codeActions').classList.remove('hidden');
                $('codeSpeedscope').href = '/edu-code-profile?token=' + encodeURIComponent(codeToken) + '&format=speedscope';
                $('codeSpeedscope').setAttribute('download', 'edu-profile-' + codeToken + '.speedscope.json');
                renderCodeTable();
            }

            function loadCode() {
                if (codeToken === '') {
                    $('summary').classList.add('hidden');
                    renderCode({ status: 'pending' });
                    return;
                }
                Promise.all([
                    query({ token: codeToken, limit: 1 }),
                    codeQuery({ token: codeToken, full: 1 })
                ]).then(function(results) {
                    var log = (results[0].logs.length > 0 ? results[0].logs[0] : null);
                    if (log !== null) {
                        renderSummary(log);
                    } else {
                        $('summary').classList.add('hidden');
                    }
                    renderCode(results[1]);
                }).catch(fail);
            }

            // ----- Navigation entre les vues -----
            function show(name) {
                view = name;
                var isSearch = name === 'search';
                $('viewSearch').classList.toggle('hidden', !isSearch);
                $('viewLogs').classList.toggle('hidden', name !== 'logs');
                $('viewRequest').classList.toggle('hidden', name !== 'request');
                $('viewSql').classList.toggle('hidden', name !== 'sql');
                $('viewCode').classList.toggle('hidden', name !== 'code');
                $('searchForm').classList.toggle('hidden', !isSearch);
                $('logsNav').classList.toggle('hidden', isSearch);
                $('searchTitle').classList.toggle('hidden', !isSearch);
                if (isSearch) { $('summary').classList.add('hidden'); }
                // État actif des entrées de navigation (sidebar)
                document.querySelectorAll('#logsNav a').forEach(function(node) {
                    node.classList.toggle('active', (name === 'request' && node.id === 'navRequest')
                        || (name === 'sql' && node.id === 'navSql')
                        || (name === 'code' && node.id === 'navCode')
                        || (name === 'logs' && node.getAttribute('href') === '#logs'));
                });
            }

            function route() {
                var hash = window.location.hash.replace(/^#/, '').split('/');
                if (hash[0] === 'logs') {
                    token = hash[1] || '';
                    $('tokenFilter').classList.toggle('hidden', token === '');
                    $('tokenFilterId').textContent = '#' + token;
                    show('logs');
                    loadLogs();
                } else if (hash[0] === 'request') {
                    requestToken = hash[1] || '';
                    updateRequestNav(requestToken);
                    show('request');
                    loadRequest();
                } else if (hash[0] === 'sql') {
                    sqlToken = hash[1] || '';
                    updateSqlNav(sqlToken);
                    if (sqlToken !== '') { $('sqlBackLink').setAttribute('href', '#request/' + sqlToken); }
                    show('sql');
                    loadSql();
                } else if (hash[0] === 'code') {
                    codeToken = hash[1] || '';
                    updateCodeNav(codeToken);
                    if (codeToken !== '') { $('codeBackLink').setAttribute('href', '#request/' + codeToken); }
                    show('code');
                    loadCode();
                } else {
                    show('search');
                    loadSearch();
                }
            }

            function readForm() {
                var data = new FormData($('searchForm'));
                var filters = {};
                data.forEach(function(value, key) { filters[key] = String(value).trim(); });
                return filters;
            }

            $('searchForm').addEventListener('submit', function(event) {
                event.preventDefault();
                searchFilters = readForm();
                if (window.location.hash !== '' && window.location.hash !== '#search') {
                    window.location.hash = '#search';
                } else {
                    loadSearch();
                }
            });

            // Clic sur un onglet : filtre les résultats sur la famille de statut,
            // comme les onglets de la vue des logs — le champ Statut du formulaire
            // de recherche est synchronisé pour refléter le filtre appliqué
            $('searchTabs').addEventListener('click', function(event) {
                var button = event.target.closest('button');
                if (button === null) { return; }
                $('searchForm').elements.status.value = button.getAttribute('data-status');
                searchFilters = readForm();
                document.querySelectorAll('#searchTabs button').forEach(function(node) { node.classList.toggle('active', node === button); });
                if (window.location.hash !== '' && window.location.hash !== '#search') {
                    window.location.hash = '#search';
                } else {
                    loadSearch();
                }
            });

            $('btnSearch').addEventListener('click', function() {
                window.location.hash = '#search';
                $('searchForm').querySelector('input').focus();
            });

            $('btnLast10').addEventListener('click', function() {
                $('searchForm').reset();
                $('searchForm').elements.limit.value = '10';
                searchFilters = { limit: 10 };
                if (view === 'search') { loadSearch(); } else { window.location.hash = '#search'; }
            });

            $('btnLatest').addEventListener('click', function() {
                query({ limit: 1 }).then(function(data) {
                    if (data.logs.length > 0) { window.location.hash = '#logs/' + data.logs[0].id; }
                }).catch(fail);
            });

            $('tabs').addEventListener('click', function(event) {
                var button = event.target.closest('button');
                if (button === null) { return; }
                logsStatus = button.getAttribute('data-status');
                document.querySelectorAll('#tabs button').forEach(function(node) { node.classList.toggle('active', node === button); });
                loadLogs();
            });

            $('codeFilters').addEventListener('change', function() { if (codeData !== null) { renderCodeTable(); } });

            $('codeTable').querySelector('thead').addEventListener('click', function(event) {
                var th = event.target.closest('th.sortable');
                if (th === null || codeData === null) { return; }
                codeSort = th.getAttribute('data-sort');
                renderCodeTable();
            });

            window.addEventListener('hashchange', route);
            route();
        })();
    </script>
</body>
</html>
