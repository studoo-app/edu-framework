                        <span class="flame-match" id="flameMatch"></span>
                        <button type="button" class="btn" id="flameReset">R&eacute;initialiser le zoom</button>
                    </div>
                    <div class="sql-meta" id="flameMeta"></div>
                    <nav class="flame-crumbs" id="flameCrumbs" aria-label="Chemin d'appels du zoom"></nav>
                    <div class="flame-axis hidden" id="flameAxis"></div>
                    <div class="flame-chart" id="flameChart"></div>
                    <p class="empty-state hidden" id="flameEmpty"></p>
                    <div class="flame-legend" id="flameLegend"></div>
                    <p class="code-note">Chaque rectangle est une fonction : sa <b>largeur</b> est son temps inclusif, la ligne du dessous contient les fonctions qu'elle appelle. Un clic zoome sur la fonction, &Eacute;chap revient au niveau pr&eacute;c&eacute;dent.</p>
                    <table class="profiler-table hidden" id="flameDetail"><tbody id="flameDetailBody"></tbody></table>
                    <div class="flame-tooltip hidden" id="flameTooltip" role="tooltip"></div>
                </div>
                <div id="codeTableView">
                <div class="code-filters" id="codeFilters">
                    <label><input type="checkbox" value="app" checked> Mon code (app/)</label>
                    <label><input type="checkbox" value="framework"> Framework</label>
                    <label><input type="checkbox" value="vendor"> D&eacute;pendances (vendor/)</label>
                    <label><input type="checkbox" value="other"> Autre</label>
                </div>
                <table class="profiler-table" id="codeTable">
                    <thead>
                        <tr>
                            <th>Fonction</th><th>Origine</th>
                            <th class="sortable sorted" data-sort="self"><button type="button">Temps propre</button></th>
                            <th class="sortable" data-sort="inclusive"><button type="button">Temps inclusif</button></th>
                        </tr>
