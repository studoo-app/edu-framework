<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Profiler | Edu Framework</title>
    <style>
        html, body { height: 100%; margin: 0; }

        body {
            font-family: 'Open Sans', Helvetica, Arial, sans-serif;
            font-size: 14px;
            color: #222;
            background-color: #f9f9f9;
            display: flex;
            flex-direction: column;
            -webkit-font-smoothing: antialiased;
        }

        a { color: #0e6db5; text-decoration: none; }
        a:hover { text-decoration: underline; }

        /* ===== Barre supérieure ===== */
        .topbar {
            height: 54px;
            background-color: #222;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 20px;
            flex-shrink: 0;
        }

        .topbar .brand { display: flex; align-items: center; gap: 12px; font-size: 22px; font-weight: 600; }
        .topbar .brand span { font-weight: normal; color: #aaa; }
        .topbar .meta { display: flex; align-items: center; gap: 14px; font-size: 12px; color: #aaa; }

        .badge-env {
            background-color: #4f805d;
            color: #fff;
            padding: 2px 8px;
            border-radius: 3px;
            font-weight: bold;
            text-transform: uppercase;
        }

        .btn {
            font-family: inherit;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            color: #fff;
            background-color: #666;
            border: 0;
            border-radius: 2px;
            padding: 6px 12px;
            text-decoration: none;
            display: inline-block;
        }

        .btn:hover { background-color: #777; text-decoration: none; }

        /* ===== Bandeau de la requête (vert / orange / rouge selon le statut) ===== */
        .summary { padding: 14px 20px 12px; color: #fff; background-color: #4f805d; flex-shrink: 0; }
        .summary.s-3xx { background-color: #3a7d8c; }
        .summary.s-4xx { background-color: #a46a1f; }
        .summary.s-5xx { background-color: #b0413e; }
        .summary h2 { margin: 0 0 10px; font-size: 24px; font-weight: 600; word-break: break-all; }
        .summary .meta { display: flex; gap: 22px; flex-wrap: wrap; font-size: 12px; }
        .summary .meta b { opacity: 0.8; margin-right: 4px; }

        .page-title { padding: 14px 20px; background-color: #e0e0e0; border-bottom: 1px solid #ccc; flex-shrink: 0; }
        .page-title h2 { margin: 0; font-size: 24px; font-weight: normal; }

        /* ===== Corps : sidebar + contenu ===== */
        .layout { display: flex; flex: 1; min-height: 0; }

        .sidebar {
            width: 220px;
            background-color: #444;
            color: #ccc;
            flex-shrink: 0;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
        }

        .sidebar .shortcuts { display: flex; gap: 8px; padding: 10px; background-color: #333; }
        .sidebar .shortcuts .btn { padding: 5px 9px; font-size: 12px; white-space: nowrap; }

        .sidebar nav a {
            color: #ddd;
            font-size: 15px;
            padding: 11px 14px;
            display: flex;
            align-items: center;
            gap: 10px;
            border-bottom: 1px solid #3a3a3a;
        }

        .sidebar nav a:hover:not(.disabled) { background-color: #555; text-decoration: none; }
        .sidebar nav a.active { background-color: #666; color: #fff; }
        .sidebar nav a.disabled { color: #777; cursor: not-allowed; }
        .sidebar nav .ico { width: 22px; text-align: center; }
        .sidebar nav .ico svg { vertical-align: -2px; }
        .sidebar nav .count { margin-left: auto; background-color: #e0e0e0; color: #444; font-size: 11px; padding: 1px 7px; border-radius: 3px; font-weight: bold; }

        .sidebar form { padding: 14px 10px; display: flex; flex-direction: column; gap: 10px; }
        .sidebar form label { display: flex; align-items: center; font-size: 13px; color: #ddd; }
        .sidebar form label span { width: 62px; flex-shrink: 0; }
        .sidebar form input, .sidebar form select {
            flex: 1;
            min-width: 0;
            font-family: inherit;
            font-size: 13px;
            padding: 5px 6px;
            border: 0;
            background-color: #ccc;
            color: #222;
        }

        .sidebar form .actions { text-align: right; }

        .sidebar .sidebar-footer { margin-top: auto; padding: 10px 14px; font-size: 11px; color: #888; border-top: 1px solid #3a3a3a; }

        .content { flex: 1; overflow-y: auto; padding: 20px; }
        .content h1 { margin: 0 0 18px; font-size: 26px; font-weight: normal; }
        .hidden { display: none !important; }

        /* ===== Onglets avec compteurs ===== */
        .tabs { display: flex; margin-bottom: 20px; }
        .tabs button {
            font-family: inherit;
            font-size: 16px;
            cursor: pointer;
            padding: 8px 14px;
            color: #444;
            background-color: #fff;
            border: 1px solid #ddd;
            border-right: 0;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .tabs button:last-child { border-right: 1px solid #ddd; }
        .tabs button:hover { background-color: #f3f3f3; }
        .tabs button.active { background-color: #666; border-color: #666; color: #fff; }
        .tabs button .count { background-color: #e8e8e8; color: #555; font-size: 12px; padding: 1px 7px; border-radius: 3px; }
        .tabs button.active .count { background-color: #222; color: #fff; }
        .tabs button.empty { color: #999; }

        /* ===== Tables ===== */
        table.profiler-table { width: 100%; border-collapse: collapse; background-color: #fff; border: 1px solid #ddd; }
        .profiler-table th { text-align: left; padding: 10px 12px; background-color: #e0e0e0; font-size: 15px; }
        .profiler-table td { padding: 12px; border-top: 1px solid #e5e5e5; vertical-align: top; }
        .profiler-table td.time { color: #777; font-size: 13px; white-space: nowrap; }
        .profiler-table td.nowrap { white-space: nowrap; }
        .profiler-table td.channel { font-weight: bold; font-size: 13px; }
        .profiler-table td.empty-state { text-align: center; color: #999; padding: 40px 0; }
        .profiler-table tr.raw td { color: #999; font-style: italic; }
        .profiler-table tr.log-row.highlight td { background-color: #fffbe6; }

        .log-context { margin-top: 6px; font-size: 12px; color: #777; word-break: break-all; }
        .log-context b { color: #444; }
        .log-context pre {
            margin: 6px 0 0;
            padding: 8px 10px;
            background-color: #f5f5f5;
            border: 1px solid #e0e0e0;
            font-size: 12px;
            white-space: pre-wrap;
            font-family: 'SFMono-Regular', Consolas, monospace;
            color: #333;
        }

        /* ===== Vue descriptif d'une requête ===== */
        .profiler-table td.req-label { width: 170px; white-space: nowrap; color: #777; font-weight: 600; }
        #requestBody pre {
            margin: 0;
            padding: 8px 10px;
            background-color: #f5f5f5;
            border: 1px solid #e0e0e0;
            font-size: 12px;
            white-space: pre-wrap;
            word-break: break-all;
            font-family: 'SFMono-Regular', Consolas, monospace;
            color: #333;
        }
        #requestBody table.params-table { width: 100%; border-collapse: collapse; font-size: 12px; font-family: 'SFMono-Regular', Consolas, monospace; }
        #requestBody table.params-table td { padding: 4px 8px; border: 1px solid #e0e0e0; vertical-align: top; word-break: break-all; }
        #requestBody table.params-table td.param-key { width: 30%; background-color: #f5f5f5; color: #555; font-weight: 600; }
        #requestBody table.params-table td.param-value pre { padding: 0; border: 0; background: none; }
        #requestBody .params-empty { color: #999; font-style: italic; }
        #requestBody pre.error-message {
            background-color: #fbeceb;
            border-color: #e6b5b3;
            color: #b0413e;
        }

        /* ===== Vue requêtes SQL ===== */
        .sql-meta { margin: 0 0 16px; font-size: 14px; color: #555; }
        .sql-meta b { color: #222; }
        .sql-query {
            margin: 0;
            padding: 8px 10px;
            background-color: #f5f5f5;
            border: 1px solid #e0e0e0;
            font-size: 12px;
            white-space: pre-wrap;
            word-break: break-all;
            font-family: 'SFMono-Regular', Consolas, monospace;
            color: #333;
        }
        .sql-group-badge {
            display: inline-block;
            margin-top: 4px;
            font-size: 11px;
            font-weight: bold;
            padding: 2px 6px;
            border-radius: 3px;
            background-color: #e0e0e0;
            color: #444;
            white-space: nowrap;
        }
        .sql-duration { font-weight: bold; white-space: nowrap; }
        .sql-duration.medium { color: #a46a1f; }
        .sql-duration.slow { color: #b0413e; }
        #sidebarSqlCount:empty { display: none; }
        .sql-actions { margin-top: 6px; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
        .btn-small { padding: 3px 9px; font-size: 12px; }
        .btn-explain { background-color: #4f805d; }
        .btn-explain:hover { background-color: #5e9a6f; }

        /* ===== Vue analyse EXPLAIN d'une requête SQL ===== */
        #viewExplain h2 { font-size: 18px; font-weight: 600; margin: 28px 0 10px; }
        #viewExplain h2 small { font-size: 13px; font-weight: normal; color: #777; margin-left: 6px; }
        #viewExplain h3 { font-size: 14px; margin: 16px 0 6px; }
        .explain-modes { margin: 18px 0 8px; }
        .explain-modes button small { font-size: 12px; opacity: .75; }
        .explain-modes button:disabled { cursor: not-allowed; color: #aaa; background-color: #f6f6f6; }
        .explain-message { margin: 12px 0; padding: 10px 14px; background-color: #fff7e8; border-left: 4px solid #a46a1f; color: #5b3d10; }
        .explain-message.loading { background-color: #f0f0f0; border-left-color: #999; color: #555; }
        .explain-error { margin: 0 0 12px; padding: 8px 10px; background-color: #fbeceb; border: 1px solid #e6b5b3; color: #b0413e; font-size: 12px; white-space: pre-wrap; word-break: break-word; font-family: 'SFMono-Regular', Consolas, monospace; }
        .explain-params input { width: 100%; box-sizing: border-box; font-family: 'SFMono-Regular', Consolas, monospace; font-size: 13px; padding: 5px 7px; border: 1px solid #ccc; border-radius: 2px; }
        .explain-params input.missing { border-color: #b0413e; background-color: #fff7f6; }
        .explain-params td.param-name { width: 180px; font-family: 'SFMono-Regular', Consolas, monospace; font-weight: 600; white-space: nowrap; }
        .explain-params td.param-origin { width: 190px; color: #777; font-size: 12px; white-space: nowrap; }
        .explain-params .actions { margin-top: 10px; }
        .explain-counts { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 12px; }
        .level-badge { display: inline-block; padding: 2px 8px; border-radius: 3px; font-size: 12px; font-weight: bold; color: #fff; white-space: nowrap; }
        .level-badge.critical { background-color: #b0413e; }
        .level-badge.warning { background-color: #a46a1f; }
        .level-badge.info { background-color: #3a7d8c; }
        .level-badge.success { background-color: #4f805d; }
        .finding { background-color: #fff; border: 1px solid #ddd; border-left: 5px solid #3a7d8c; padding: 10px 14px; margin: 0 0 10px; }
        .finding.critical { border-left-color: #b0413e; }
        .finding.warning { border-left-color: #a46a1f; }
        .finding.success { border-left-color: #4f805d; }
        .finding-head { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
        .finding-head b { font-size: 15px; }
        .finding p { margin: 6px 0 0; color: #444; line-height: 1.5; }
        .finding .sql-suggestion { margin-top: 8px; display: flex; gap: 8px; align-items: flex-start; }
        .finding .sql-suggestion pre { flex: 1; }
        .sql-suggestion pre.sql-query { word-break: normal; overflow-wrap: anywhere; }
        .explain-script { margin: 14px 0 0; padding: 12px 14px; background-color: #fff; border: 1px solid #ddd; }
        .explain-script h3 { margin-top: 0 !important; }
        .explain-script .code-note { margin: 8px 0 0; }
        .plan-table td, .plan-table th { font-size: 13px; white-space: nowrap; }
        .plan-table th abbr { text-decoration: none; border-bottom: 1px dotted #888; cursor: help; }
        .plan-table td.extra { white-space: normal; min-width: 180px; }
        .plan-table td.null { color: #bbb; }
        .plan-type { display: inline-block; padding: 1px 7px; border-radius: 3px; font-weight: bold; font-family: 'SFMono-Regular', Consolas, monospace; }
        .plan-type.ok, .plan-flag.ok { background-color: #d7f0dd; color: #1f6b3a; }
        .plan-type.mid, .plan-flag.mid { background-color: #fff1c2; color: #7a5b00; }
        .plan-type.bad, .plan-flag.bad { background-color: #fbdcda; color: #9c2f2b; }
        .plan-flag { display: inline-block; margin: 1px 4px 1px 0; padding: 0 5px; border-radius: 2px; font-size: 12px; background-color: #eee; color: #555; }
        .plan-tree, .plan-text {
            margin: 0; padding: 10px 12px; background-color: #fff; border: 1px solid #ddd; font-size: 12px; line-height: 1.7;
            font-family: 'SFMono-Regular', Consolas, monospace; white-space: pre; overflow-x: auto; color: #333;
        }
        .plan-tree ul { list-style: none; margin: 0; padding-left: 22px; }
        .plan-tree > ul { padding-left: 0; }
        .plan-tree li::before { content: '\2514\2500 '; color: #aaa; }
        .plan-tree > ul > li::before { content: ''; }
        .plan-line.ok { color: #1f6b3a; }
        .plan-line.mid { color: #7a5b00; }
        .plan-line.bad { color: #9c2f2b; font-weight: bold; }
        .plan-text .actual { color: #0b62a3; }
        .explain-tables { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 14px; }
        .explain-tables .profiler-table th { font-size: 14px; }
        .explain-tables .profiler-table td { padding: 7px 10px; font-size: 13px; }
        .explain-tables .idx-cols { font-family: 'SFMono-Regular', Consolas, monospace; }
        .explain-tables .tag { display: inline-block; margin-left: 6px; padding: 0 5px; border-radius: 2px; font-size: 11px; font-weight: bold; background-color: #cfe2ff; color: #0b4f8a; }
        .explain-tables .tag.pk { background-color: #fff1c2; color: #7a5b00; }
        details.explain-help { margin-top: 28px; background-color: #fff; border: 1px solid #ddd; padding: 10px 14px; }
        details.explain-help summary { cursor: pointer; font-weight: 600; font-size: 15px; }
        details.explain-help dl { display: grid; grid-template-columns: 160px 1fr; gap: 6px 14px; margin: 12px 0 0; font-size: 13px; }
        details.explain-help dt { font-family: 'SFMono-Regular', Consolas, monospace; font-weight: bold; }
        details.explain-help dd { margin: 0; color: #444; }
        details.explain-help h4 { margin: 16px 0 0; font-size: 14px; }
        @media (max-width: 800px) { details.explain-help dl { grid-template-columns: 1fr; } }

        /* ===== Badges ===== */
        .m-GET, .m-POST, .m-PUT, .m-DELETE, .m-PATCH, .m-OTHER { font-weight: bold; font-size: 12px; padding: 1px 6px; border-radius: 3px; color: #000; background-color: #ddd; }
        .m-GET { background-color: #61affe; }
        .m-POST { background-color: #ffc862; }
        .m-PUT { background-color: #fca02f; }
        .m-DELETE { background-color: #f93e3e; color: #fff; }
        .m-PATCH { background-color: #50e3c2; }

        .sapi-badge { display: inline-block; font-size: 11px; font-weight: bold; padding: 2px 6px; border-radius: 3px; background-color: #e0e0e0; color: #555; white-space: nowrap; }
        .sapi-badge.cli-server { background-color: #cfe2ff; color: #0b4f8a; }
        .sapi-badge.frankenphp { background-color: #d7f0dd; color: #1f6b3a; }

        .status-badge { display: inline-block; min-width: 38px; text-align: center; font-weight: bold; color: #fff; padding: 4px 8px; border-radius: 2px; background-color: #4f805d; }
        .status-badge.s-3xx { background-color: #3a7d8c; }
        .status-badge.s-4xx { background-color: #a46a1f; }
        .status-badge.s-5xx { background-color: #b0413e; }
        .status-text.s-2xx { color: #4f805d; }
        .status-text.s-3xx { color: #3a7d8c; }
        .status-text.s-4xx { color: #a46a1f; }
        .status-text.s-5xx { color: #b0413e; }
        .status-text { font-weight: bold; }

        .back-link { margin-bottom: 14px; }
        /* Onglet Code : profiler du code PHP (Excimer) */
        .code-filters { display: flex; flex-wrap: wrap; gap: 14px; margin: 0 0 14px; font-size: 14px; }
        .code-filters label { display: flex; align-items: center; gap: 6px; cursor: pointer; }
        .code-note { margin: 0 0 16px; font-size: 13px; color: #777; }
        .code-actions { margin: 0 0 16px; display: flex; gap: 10px; flex-wrap: wrap; }
        .origin-badge { display: inline-block; padding: 2px 6px; border-radius: 2px; font-size: 12px; font-weight: bold; white-space: nowrap; background: #eee; color: #555; }
        .origin-badge.app { background: #fff1c2; color: #7a5b00; }
        .origin-badge.framework { background: #cfe2ff; color: #0b4f8a; }
        .origin-badge.vendor { background: #e8e0f5; color: #5a3d8a; }
        #codeBody tr.app td { background: #fffbea; }
        #codeBody tr { cursor: pointer; }
        #codeBody tr.selected td { background: #e8f0fe; }
        .code-fn { font-family: monospace; font-size: 13px; word-break: break-all; }
        .code-file { display: block; color: #888; font-size: 12px; font-family: monospace; word-break: break-all; }
        .code-bar { display: inline-block; height: 6px; background: #4f805d; border-radius: 3px; vertical-align: middle; margin-right: 6px; }
        .profiler-table th.sortable button { all: inherit; cursor: pointer; user-select: none; display: inline; padding: 0; border: 0; background: none; }
        .profiler-table th.sortable button:focus-visible, .code-fn-btn:focus-visible { outline: 2px solid #4f805d; outline-offset: 2px; }
        .profiler-table th.sortable.sorted button::after { content: ' \25BE'; }
        .code-fn-btn { font-family: monospace; font-size: 13px; color: inherit; text-align: left; background: none; border: 0; padding: 0; cursor: pointer; }
        #codeGraph .code-fn-btn { color: #0b62a3; text-decoration: underline; }
        #codeGraph { margin-top: 24px; }
        #codeGraph h2 { font-size: 16px; margin: 0 0 10px; }
        .code-graph-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
        .code-graph-cols h3 { font-size: 13px; text-transform: uppercase; color: #777; margin: 0 0 6px; }
        .code-graph-cols a { cursor: pointer; }
        .profiled-badge { display: inline-block; margin-left: 6px; padding: 1px 5px; border-radius: 2px; font-size: 11px; background: #fff1c2; color: #7a5b00; text-decoration: none; }
        @media (max-width: 800px) { .code-graph-cols { grid-template-columns: 1fr; } }

        /* Onglet Code : flamegraph intégré */
        #codeModes { margin-bottom: 16px; }
        .flame-toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin: 0 0 12px; font-size: 14px; }
        .flame-toolbar input[type=search] { padding: 6px 8px; border: 1px solid #ccc; border-radius: 3px; min-width: 240px; font-size: 13px; }
        .flame-toolbar select { padding: 5px; margin-left: 4px; font-size: 13px; max-width: 420px; }
        .flame-match { font-size: 13px; color: #555; }
        .flame-crumbs { display: flex; flex-wrap: wrap; gap: 4px; margin: 0 0 8px; font-size: 12px; color: #999; }
        .flame-crumbs button { font-family: monospace; font-size: 12px; color: #0b62a3; text-decoration: underline; background: none; border: 0; padding: 0; cursor: pointer; }
        .flame-crumbs b { font-family: monospace; color: #222; }
        .flame-axis { position: relative; height: 18px; font-size: 11px; color: #888; border: 1px solid #ddd; border-bottom: 0; background: #fafafa; }
        .flame-axis span { position: absolute; top: 2px; padding-left: 3px; border-left: 1px solid #ccc; white-space: nowrap; }
        .flame-chart { position: relative; overflow: hidden; background: #fff; border: 1px solid #ddd; }
        .flame-node {
            position: absolute; height: 18px; margin: 0; padding: 0 4px; box-sizing: border-box;
            border: 0; border-right: 1px solid #fff; border-bottom: 1px solid #fff; border-radius: 0;
            font: 12px/17px monospace; color: #222; text-align: left;
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis; cursor: pointer;
        }
        .flame-node:hover { filter: brightness(.92); }
        .flame-node:focus-visible { outline: 2px solid #222; outline-offset: -2px; z-index: 1; }
        .flame-node.ancestor { opacity: .55; }
        .flame-node.dim { opacity: .25; }
        .flame-node.match { box-shadow: inset 0 0 0 2px #b0413e; }
        .flame-legend { display: flex; flex-wrap: wrap; gap: 14px; margin: 10px 0 8px; font-size: 12px; color: #555; }
        .flame-legend i { display: inline-block; width: 12px; height: 12px; margin-right: 5px; border-radius: 2px; vertical-align: -2px; }
        #flameEmpty { padding: 30px 0; text-align: center; color: #999; background: #fff; border: 1px solid #ddd; margin: 0; }
        #flameDetail { margin-top: 6px; }
        #flameDetail .req-label { width: 180px; }
        .flame-tooltip {
            position: fixed; z-index: 10; max-width: 460px; padding: 8px 10px; pointer-events: none;
            background: #222; color: #ddd; font-size: 12px; line-height: 1.5; border-radius: 3px; box-shadow: 0 2px 8px rgba(0, 0, 0, .3);
        }
        .flame-tooltip b { display: block; color: #fff; font-family: monospace; word-break: break-all; }
        .flame-tooltip .slower { color: #ff9b94; }
        .flame-tooltip .faster { color: #9fc6ff; }
    </style>
</head>
<body>
    <header class="topbar">
        <div class="brand">
            <img src="{{ logoEF }}" alt="Logo Edu Framework" width="30px">
            <div>Edu Framework <span>Profiler</span></div>
        </div>
        <div class="meta">
            <span class="badge-env">{{ appEnv }}</span>
            <span>{{ version }}</span>
            <span>PHP {{ phpVersion }}</span>
            <a class="btn" href="https://studoo-app.github.io/edu-framework" target="_blank" rel="noopener">Documentation</a>
        </div>
    </header>

    <section class="summary" id="summary">
        <h2 id="summaryUrl"></h2>
    </section>

    <section class="page-title" id="searchTitle"><h2>Recherche de requ&ecirc;tes</h2></section>

    <div class="layout">
        <aside class="sidebar">
            <div class="shortcuts">
                <button type="button" class="btn" id="btnLast10">10 derniers</button>
                <button type="button" class="btn" id="btnLatest">Dernier</button>
                <button type="button" class="btn" id="btnSearch" title="Recherche">&#128269;</button>
            </div>

            <nav id="logsNav">
                <a href="#" id="navRequest" class="disabled" title="Ouvrez le descriptif d'une requ&ecirc;te depuis la barre de debug ou la recherche"><span class="ico">&#9881;</span> Requ&ecirc;te</a>
                <a href="#" id="navSql" class="disabled" title="Ouvrez le descriptif d'une requ&ecirc;te puis cliquez sur la ligne Requ&ecirc;tes SQL"><span class="ico"><svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><ellipse cx="8" cy="3.75" rx="5.5" ry="2.25"/><path d="M2.5 3.75v8.5c0 1.24 2.46 2.25 5.5 2.25s5.5-1.01 5.5-2.25v-8.5"/><path d="M2.5 8c0 1.24 2.46 2.25 5.5 2.25S13.5 9.24 13.5 8"/></svg></span> SQL <span id="sidebarSqlCount" class="count"></span></a>
                <a href="#" id="navCode" class="disabled" title="Activez le profilage avec le bloc Code de la barre de debug, puis ouvrez le profil d'une requ&ecirc;te"><span class="ico">&#9201;</span> Code</a>
                <a href="#logs" class="active"><span class="ico">&#9776;</span> Logs <span id="sidebarCount" class="count">0</span></a>
            </nav>

