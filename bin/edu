#!/usr/bin/env php
<?php
/*
/*     ______    __            ______                                             __  
 *    / ____/___/ /_  __      / ____/________ _____ ___  ___ _      ______  _____/ /__
 *   / __/ / __  / / / /_____/ /_  / ___/ __ `/ __ `__ \/ _ \ | /| / / __ \/ ___/ //_/
 *  / /___/ /_/ / /_/ /_____/ __/ / /  / /_/ / / / / / /  __/ |/ |/ / /_/ / /  / ,<   
 * /_____/\__,_/\__,_/     /_/   /_/   \__,_/_/ /_/ /_/\___/|__/|__/\____/_/  /_/|_|   
